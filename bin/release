#!/usr/bin/env bash
set -Eeuo pipefail

APP_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROD_HOST="178.156.250.235"
PROD_SERVICE="legion_post_165_wi_tools"
PROD_IMAGE="ghcr.io/andrerobitaille/legion-post-165-wi-tools"
PROD_URL="https://members.wipost165.org"
COHOSTED_URL="https://tworiversmatters.com"
PUBLIC_POST_URL="https://wipost165.org"
SSH_CONFIG="${RELEASE_SSH_CONFIG:-/home/andre/.ssh/config}"
release_activation_email="${BUDDY_CHECK_ACTIVATE_EMAIL:-}"
cd "$APP_ROOT"
source lib/release_image.sh

fail() { echo "release: $*" >&2; return 1; }
current_branch() { git symbolic-ref --quiet --short HEAD || fail 'detached HEAD cannot be released'; }
remote_head() { git ls-remote --heads origin "refs/heads/$1" | awk 'NR == 1 {print $1}'; }
assert_clean_worktree() {
  git diff --quiet || { fail 'working tree has unstaged changes'; return 1; }
  git diff --cached --quiet || { fail 'index has staged changes'; return 1; }
  [[ -z "$(git ls-files --others --exclude-standard)" ]] || fail 'working tree has untracked files'
}
assert_remote_matches_head() {
  local branch head remote
  branch="$(current_branch)" || return
  head="$(git rev-parse HEAD)" || return
  remote="$(remote_head "$branch")" || return
  [[ "$head" == "$remote" ]] || fail "origin/$branch does not match HEAD; push the reviewed revision separately"
}
push_head() {
  assert_clean_worktree
  local branch
  branch="$(current_branch)"
  git push --set-upstream origin "HEAD:refs/heads/$branch"
  assert_remote_matches_head
}

require_release_session() {
  [[ -n "${RELEASE_CONTROL_PATH:-}" && -n "${RELEASE_SESSION_ROOT:-}" &&
     -r "${release_temp_config:-}" ]] || { fail 'use the owned bin/release session'; return 1; }
  ssh -F "$SSH_CONFIG" -S "$RELEASE_CONTROL_PATH" -O check "$PROD_HOST" >/dev/null 2>&1 ||
    fail 'SSH master lost; stop. Wait at least five minutes before one chosen replacement attempt'
}
release_ssh() {
  require_release_session || return
  ssh -F "$SSH_CONFIG" -S "$RELEASE_CONTROL_PATH" -o ControlMaster=no \
    -o ProxyCommand=false -o BatchMode=yes "$PROD_HOST" "$@"
}
release_kamal() (
  require_release_session || return
  local argument
  for argument in "$@"; do
    case "$argument" in
      -c*|--config-file|--config-file=*|--config_file|--config_file=*)
        fail 'release_kamal selects the session configuration; do not pass -c or --config-file'
        return 1
        ;;
    esac
  done
  cd "$APP_ROOT" || return
  unset SSH_AUTH_SOCK
  bin/kamal "$@" -c "$release_temp_config"
)
prepare_kamal_config() {
  ruby -ryaml -rshellwords -e '
    source, output, host, control, key, ssh_config = ARGV
    config = YAML.safe_load_file(source, aliases: true)
    config["ssh"] = {
      "user" => "root", "keys" => [key], "keys_only" => true, "config" => false,
      "proxy_command" => Shellwords.join(["ssh", "-F", ssh_config, "-S", control,
        "-o", "ControlMaster=no", "-o", "ProxyCommand=false", "-o", "BatchMode=yes", "-W", "127.0.0.1:22", host])
    }
    File.write(output, YAML.dump(config))
  ' config/deploy.yml "$release_temp_config" "$PROD_HOST" "$RELEASE_CONTROL_PATH" "$1" "$SSH_CONFIG"
}
assert_http_status() {
  local url="$1" expected="$2" status
  status="$(curl --silent --show-error --max-time 20 --output /dev/null --write-out '%{http_code}' "$url")" || return
  [[ "$status" == "$expected" ]] || { fail "$url returned $status; expected $expected"; return 1; }
  echo "$url -> $status"
}
protected_containers() {
  local service ids
  for service in two_rivers_reporter legion_post_165_wi_public; do
    ids="$(release_ssh "docker ps --filter label=service=$service --format '{{.ID}}'" )" || return
    [[ -n "$ids" ]] || { fail "no running container for $service"; return 1; }
    printf '%s %s\n' "$service" "$ids"
  done
  release_ssh "docker inspect --format '{{.Id}}' $PROD_SERVICE-db"
}
release_preflight() {
  export RELEASE_PREFLIGHT_OK=0
  release_ssh 'hostname && docker --version && free -m && cat /proc/pressure/memory && docker stats --no-stream' || return
  release_kamal config >/dev/null || return
  release_kamal server exec hostname || return
  protected_containers > "$RELEASE_SESSION_ROOT/protected-containers" || return
  assert_http_status "$PROD_URL/up" 200 || return
  assert_http_status "$COHOSTED_URL/" 200 || return
  assert_http_status "$PUBLIC_POST_URL/" 200 || return
  probe_mobile_readiness || return
  export RELEASE_PREFLIGHT_OK=1
  echo 'Preflight passed. Inspect headroom for image extraction and old/new app overlap; coordinate deployments across all three apps.'
}
release_verify() (
  set -Eeuo pipefail
  cd "$APP_ROOT"
  [[ "${RELEASE_PREFLIGHT_OK:-}" == 1 ]] || { fail 'preflight required'; exit 1; }
  local head containers
  head="$(git rev-parse HEAD)" || exit 1
  containers="$(release_ssh "docker ps --filter label=service=$PROD_SERVICE --filter label=role=web --format '{{.Names}}'")" || exit 1
  [[ "$containers" == "$PROD_SERVICE-web-$head" ]] || { fail "running $PROD_SERVICE container does not match $head"; exit 1; }
  protected_containers > "$RELEASE_SESSION_ROOT/protected-after" || exit 1
  cmp "$RELEASE_SESSION_ROOT/protected-containers" "$RELEASE_SESSION_ROOT/protected-after" || { fail 'protected cohost/database containers changed'; exit 1; }
  assert_http_status "$PROD_URL/up" 200 || exit 1
  assert_http_status "$PROD_URL/session/new" 200 || exit 1
  assert_http_status "$COHOSTED_URL/" 200 || exit 1
  assert_http_status "$PUBLIC_POST_URL/" 200 || exit 1
  echo "Production revision and all three sites verified at $head. Check authorized Jobs worker health and affected workflows before closing this session."
)
release_deploy() { release_run; }
probe_mobile_readiness() {
  [[ -n "$release_activation_email" ]] || return 0
  local require_ready="${1:-false}" container
  container="$(release_ssh \
    "docker ps --filter label=service=$PROD_SERVICE --filter label=role=web --format '{{.Names}}'")" || return
  [[ "$container" =~ ^legion_post_165_wi_tools-web-[a-f0-9]+$ ]] || { fail 'expected one running Post 165 web container for readiness probe'; return 1; }
  release_ssh \
    "docker exec -i -e BUDDY_CHECK_ACTIVATE_EMAIL=$release_activation_email -e BUDDY_CHECK_REQUIRE_READY=$require_ready $container bin/rails runner -" \
    < script/mobile_buddy_check_readiness.rb
}

local_check() {
  local file
  for file in bin/release bin/publish-image lib/release_image.sh lib/production_image.sh \
    script/build_production_image script/profile_production_image script/smoke_production_startup \
    .kamal/hooks/pre-build .kamal/hooks/pre-deploy; do
    bash -n "$file"
  done
  ruby -ryaml -e '
    c = YAML.safe_load_file("config/deploy.yml", aliases: true)
    abort "Service changed" unless c["service"] == "legion_post_165_wi_tools"
    abort "Image changed" unless c["image"] == "andrerobitaille/legion-post-165-wi-tools"
    abort "Architecture changed" unless c.dig("builder", "arch") == "amd64"
  '
  echo 'Local release checks passed; no production connection was opened.'
}
cleanup_session() {
  ssh -F "$SSH_CONFIG" -S "$RELEASE_CONTROL_PATH" -O exit "$PROD_HOST" >/dev/null 2>&1 || true
  rm -rf -- "$RELEASE_SESSION_ROOT"
}
release_session() {
  [[ -z "${RELEASE_CONTROL_PATH:-}" ]] || { fail 'a release session is already open'; return 1; }
  [[ -r "$SSH_CONFIG" ]] || { fail "missing SSH config: $SSH_CONFIG"; return 1; }
  local identity_file
  identity_file="$(ssh -F "$SSH_CONFIG" -G "$PROD_HOST" 2>/dev/null | awk '$1 == "identityfile" {$1 = ""; sub(/^ /, ""); print; exit}')"
  identity_file="${identity_file/#\~/$HOME}"
  [[ -r "$identity_file" ]] || { fail 'configured IdentityFile must be readable'; return 1; }
  umask 077
  RELEASE_SESSION_ROOT="$(mktemp -d /tmp/legion-release.XXXXXX)"
  RELEASE_CONTROL_PATH="$RELEASE_SESSION_ROOT/master"
  release_temp_config="$RELEASE_SESSION_ROOT/deploy.yml"
  trap cleanup_session EXIT
  prepare_kamal_config "$identity_file"
  # One outer connection, owned by this session. Never reuse/restart a stale master.
  timeout 45 ssh -F "$SSH_CONFIG" -S "$RELEASE_CONTROL_PATH" -o ControlMaster=yes \
    -o ControlPersist=yes -o BatchMode=yes -o ConnectTimeout=15 \
    -o IdentityAgent=none -o IdentitiesOnly=yes \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=6 -Nf "$PROD_HOST"
  require_release_session
  unset SSH_AUTH_SOCK
  export APP_ROOT PROD_HOST PROD_SERVICE PROD_IMAGE PROD_URL COHOSTED_URL PUBLIC_POST_URL SSH_CONFIG
  export RELEASE_SESSION_ROOT RELEASE_CONTROL_PATH release_temp_config release_activation_email
  export -f fail current_branch remote_head assert_clean_worktree assert_remote_matches_head
  export -f require_release_session release_ssh release_kamal assert_http_status protected_containers
  export -f release_preflight release_verify release_deploy release_run require_image_digest verify_prebuilt_image probe_mobile_readiness
  cat > "$RELEASE_SESSION_ROOT/bashrc" <<'RC'
# Keep diagnosis possible even if the caller exported errexit in SHELLOPTS.
set +e
unset PROMPT_COMMAND
HISTFILE=/dev/null
cd "$APP_ROOT"
PS1='release> '
release_preflight
printf '%s\n' 'Session remains open after failures. Stop and investigate; no automatic retry or reconnect.' \
  'Set RELEASE_IMAGE_DIGEST, then release_deploy. Use release_verify / release_ssh / release_kamal for authorized checks. Exit only after final verification.'
RC
  env -u SHELLOPTS -u BASHOPTS bash --noprofile --rcfile "$RELEASE_SESSION_ROOT/bashrc" -i
}

[[ $# == 1 ]] || { echo 'Usage: bin/release check|push|session' >&2; exit 64; }
if [[ -n "$release_activation_email" ]]; then
  [[ "$release_activation_email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]] || { fail 'invalid activation email'; exit 1; }
fi
case "$1" in
  check) local_check ;;
  push) push_head ;;
  session) release_session ;;
  verify-image)
    require_release_session
    [[ "${RELEASE_PREFLIGHT_OK:-}" == 1 ]] || { fail 'preflight required before image verification'; exit 1; }
    assert_clean_worktree
    assert_remote_matches_head
    [[ "${KAMAL_VERSION:-}" == "$(git rev-parse HEAD)" ]] || { fail 'Kamal revision does not match reviewed HEAD'; exit 1; }
    verify_prebuilt_image "$KAMAL_VERSION"
    ;;
  deploy|push-deploy|setup)
    fail 'standalone deployment is disabled; use bin/release session, then release_deploy with RELEASE_IMAGE_DIGEST'
    exit 1
    ;;
  *) echo 'Usage: bin/release check|push|session' >&2; exit 64 ;;
esac
