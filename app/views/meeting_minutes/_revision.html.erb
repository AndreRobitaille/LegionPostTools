<% attendance = revision.payload.fetch("attendance") %>
<% if attendance.any? %>
  <section class="minutes-doc-attendance" aria-labelledby="member-attendance-heading">
    <h2 id="member-attendance-heading">Officer attendance</h2>
    <table>
      <thead><tr><th>Office</th><th>Officer</th><th>Attendance</th></tr></thead>
      <tbody>
        <% attendance.each do |entry| %>
          <tr>
            <th scope="row"><%= entry.fetch("office_name") %></th>
            <td><%= entry["person_name"].presence || (entry.fetch("status") == "vacant" ? "Vacant" : "Not recorded") %></td>
            <td><%= entry.fetch("status").humanize %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
<% end %>

<div class="agenda-outline">
  <% revision.payload.fetch("sections").each_with_index do |section, section_index| %>
    <section class="agenda-chapter">
      <div class="agenda-chapter-rail" aria-hidden="true"><span class="agenda-chapter-number"><%= section_index + 1 %></span></div>
      <div class="agenda-chapter-content">
        <header class="agenda-chapter-head"><h2><%= section.fetch("title") %></h2></header>
        <ol class="agenda-chapter-items">
          <% if section.fetch("items").empty? %><li class="agenda-chapter-empty">No business was recorded in this section.</li><% end %>
          <% section.fetch("items").each do |item| %>
            <li id="minutes-item-<%= item.fetch("record_key") %>" class="agenda-item">
              <h3 class="agenda-item-title minutes-item-title"><%= item.fetch("title") %></h3>
              <% if item["agenda_body_html"].present? %><div class="minutes-agenda-wording agenda-item-body lexxy-content"><%= sanitize(item["agenda_body_html"]) %></div><% end %>
              <% if item["body_html"].present? %>
                <div class="minutes-recorded-wording">
                  <p class="member-document-label">Recorded minutes</p>
                  <div class="agenda-item-body lexxy-content"><%= sanitize(item["body_html"]) %></div>
                </div>
              <% end %>
              <% item.fetch("outcomes").each do |outcome| %>
                <% outcome_tone = { "adopted" => "passed", "lost" => "failed" }.fetch(outcome.fetch("disposition"), "other") %>
                <section class="minutes-doc-outcome minutes-doc-outcome--<%= outcome_tone %>">
                  <h4 class="minutes-doc-outcome-head"><%= outcome.fetch("kind").humanize %></h4>
                  <p class="minutes-doc-outcome-text"><%= outcome.fetch("text") %></p>
                  <dl class="minutes-doc-outcome-facts">
                    <% if outcome.fetch("kind") == "motion" || outcome["mover_name"].present? %>
                      <div><dt>Moved by</dt><dd><%= outcome["mover_name"].presence || "Not recorded" %></dd></div>
                    <% end %>
                    <% if outcome.fetch("kind") == "motion" || outcome["seconder_name"].present? %>
                      <div><dt>Seconded by</dt><dd><%= outcome["seconder_name"].presence || "Not recorded" %></dd></div>
                    <% end %>
                    <div><dt>Result</dt><dd class="minutes-doc-result"><%= revision_outcome_label(outcome.fetch("disposition")) %></dd></div>
                    <% if outcome["vote_summary"].present? %><div class="minutes-doc-outcome-note"><dt>Vote / notes</dt><dd><%= outcome["vote_summary"] %></dd></div><% end %>
                  </dl>
                </section>
              <% end %>
            </li>
          <% end %>
        </ol>
      </div>
    </section>
  <% end %>
</div>
