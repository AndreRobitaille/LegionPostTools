<article class="card agenda-section" data-reorder-item data-reorder-id="<%= agenda_section.id %>">
  <header class="card-head">
    <%= render "shared/drag_handle", label: agenda_section.title, extra_class: "section-handle" %>
    <span class="agenda-section-num" aria-hidden="true"><%= section_number %></span>
    <h3 class="agenda-section-name"><%= agenda_section.title %></h3>
    <span class="agenda-section-count"><%= pluralize(agenda_section.agenda_items.size, "item") %></span>
    <div class="agenda-section-actions">
      <% if section_number > 1 %>
        <%= button_to "Move up", move_admin_meeting_type_agenda_section_path(meeting_type, agenda_section, direction: "up"), method: :patch,
              class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} up" } %>
      <% end %>
      <% if section_number < section_count %>
        <%= button_to "Move down", move_admin_meeting_type_agenda_section_path(meeting_type, agenda_section, direction: "down"), method: :patch,
              class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} down" } %>
      <% end %>
      <%= link_to "Rename", edit_admin_meeting_type_agenda_section_path(meeting_type, agenda_section), class: "section-action" %>
      <% if agenda_section.agenda_items.empty? && section_count > 1 %>
        <%= button_to "Remove", admin_meeting_type_agenda_section_path(meeting_type, agenda_section), method: :delete,
              class: "section-action section-action--danger",
              data: { turbo_confirm: "Remove the empty “#{agenda_section.title}” section?" } %>
      <% end %>
    </div>
  </header>

  <div class="card-body">
    <% if agenda_section.agenda_items.any? %>
      <div data-controller="reorder" data-reorder-url-value="<%= reorder_admin_meeting_type_agenda_items_path(meeting_type, meeting_type_agenda_section_id: agenda_section.id) %>">
        <div class="agenda-items" data-reorder-target="list">
          <% agenda_section.agenda_items.each do |item| %>
            <div class="agenda-item-row" data-reorder-item data-reorder-id="<%= item.id %>">
              <%= render "shared/drag_handle", label: item.title %>
              <div class="agenda-item-copy">
                <span class="agenda-item-name"><%= item.title %></span>
                <% if item.summary.present? %><span class="agenda-item-note"><%= item.summary %></span><% end %>
                <%= render "admin/shared/agenda_item_status_flags", item: item %>
              </div>
              <div class="agenda-item-actions">
                <% unless item.active? %><span class="catrow-flag">Inactive</span><% end %>
                <%= link_to "Edit", edit_admin_meeting_type_agenda_item_path(meeting_type, item), class: "catrow-edit" %>
                <%= button_to admin_meeting_type_agenda_item_path(meeting_type, item), method: :delete, class: "row-del",
                      aria: { label: "Remove #{item.title}" },
                      data: { turbo_confirm: "Remove “#{item.title}” from this agenda?" } do %>
                  <%= render "shared/trash_icon" %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <span class="pos-status section-order-status" data-reorder-target="status" role="status" aria-live="polite"></span>
      </div>
    <% else %>
      <div class="agenda-section-empty">
        <span class="agenda-section-empty-mark" aria-hidden="true">&#9671;</span>
        <div>
          <strong>Nothing in this section yet</strong>
          Add an item from the post’s agenda catalog.
        </div>
      </div>
    <% end %>

    <div class="agenda-section-foot">
      <%= link_to new_admin_meeting_type_agenda_item_path(meeting_type, meeting_type_agenda_section_id: agenda_section.id), class: "section-add" do %>
        <span class="section-add-mark" aria-hidden="true">&#43;</span> Add catalog item
      <% end %>
    </div>
  </div>
</article>
