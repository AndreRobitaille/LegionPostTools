<article class="agenda-section-editor" data-reorder-item data-reorder-id="<%= agenda_section.id %>">
  <header class="agenda-section-editor-head">
    <button type="button" class="section-handle" aria-label="Drag to reorder <%= agenda_section.title %>">
      <svg width="14" height="20" viewBox="0 0 12 18" aria-hidden="true" focusable="false">
        <g fill="currentColor">
          <circle cx="3" cy="3" r="1.6"/><circle cx="9" cy="3" r="1.6"/>
          <circle cx="3" cy="9" r="1.6"/><circle cx="9" cy="9" r="1.6"/>
          <circle cx="3" cy="15" r="1.6"/><circle cx="9" cy="15" r="1.6"/>
        </g>
      </svg>
    </button>
    <span class="agenda-section-number"><%= section_number.to_s.rjust(2, "0") %></span>
    <div class="agenda-section-title-block">
      <span class="agenda-section-eyebrow">Agenda section</span>
      <h3><%= agenda_section.title %></h3>
    </div>
    <span class="agenda-section-count"><%= pluralize(agenda_section.agenda_items.size, "item") %></span>
    <div class="agenda-section-actions">
      <% if section_number > 1 %>
        <%= button_to "Move up", move_admin_meeting_type_agenda_section_path(meeting_type, agenda_section, direction: "up"), method: :patch,
              class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} up" } %>
      <% end %>
      <% if section_number < section_count %>
        <%= button_to "Move down", move_admin_meeting_type_agenda_section_path(meeting_type, agenda_section, direction: "down"), method: :patch,
              class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} down" } %>
      <% end %>
      <%= link_to "Rename", edit_admin_meeting_type_agenda_section_path(meeting_type, agenda_section), class: "section-action" %>
      <% if agenda_section.agenda_items.empty? && section_count > 1 %>
        <%= button_to "Remove", admin_meeting_type_agenda_section_path(meeting_type, agenda_section), method: :delete, class: "section-action section-action--danger",
              data: { turbo_confirm: "Remove the empty “#{agenda_section.title}” section?" } %>
      <% end %>
    </div>
  </header>

  <div class="agenda-section-editor-body">
    <% if agenda_section.agenda_items.any? %>
      <div data-controller="reorder" data-reorder-url-value="<%= reorder_admin_meeting_type_agenda_items_path(meeting_type, meeting_type_agenda_section_id: agenda_section.id) %>">
        <div class="section-item-list" data-reorder-target="list">
          <% agenda_section.agenda_items.each do |item| %>
            <div class="section-item-row" data-reorder-item data-reorder-id="<%= item.id %>">
              <button type="button" class="pos-handle" aria-label="Drag to reorder <%= item.title %>">
                <svg width="12" height="18" viewBox="0 0 12 18" aria-hidden="true" focusable="false">
                  <g fill="currentColor"><circle cx="3" cy="3" r="1.6"/><circle cx="9" cy="3" r="1.6"/><circle cx="3" cy="9" r="1.6"/><circle cx="9" cy="9" r="1.6"/><circle cx="3" cy="15" r="1.6"/><circle cx="9" cy="15" r="1.6"/></g>
                </svg>
              </button>
              <div class="section-item-copy">
                <span class="section-item-title"><%= item.title %></span>
                <% if item.summary.present? %><span class="section-item-summary"><%= item.summary %></span><% end %>
              </div>
              <% unless item.active? %><span class="catrow-flag">Inactive</span><% end %>
              <%= link_to "Edit", edit_admin_meeting_type_agenda_item_path(meeting_type, item), class: "catrow-edit" %>
              <%= button_to admin_meeting_type_agenda_item_path(meeting_type, item), method: :delete, class: "row-del",
                    aria: { label: "Remove #{item.title}" }, data: { turbo_confirm: "Remove “#{item.title}” from this agenda?" } do %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                  <path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2m2 0v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V6" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M10 11v6M14 11v6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              <% end %>
            </div>
          <% end %>
        </div>
        <span class="pos-status" data-reorder-target="status" role="status" aria-live="polite"></span>
      </div>
    <% else %>
      <div class="agenda-section-empty">
        <span class="agenda-section-empty-mark" aria-hidden="true">◇</span>
        <div><strong>This section is ready for its first item.</strong><span>Choose from the post’s agenda catalog.</span></div>
      </div>
    <% end %>

    <div class="agenda-section-footer">
      <%= link_to new_admin_meeting_type_agenda_item_path(meeting_type, meeting_type_agenda_section_id: agenda_section.id), class: "section-add-link" do %>
        <span aria-hidden="true">＋</span> Add catalog item
      <% end %>
    </div>
  </div>
</article>
