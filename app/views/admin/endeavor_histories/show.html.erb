<% content_for :title, "Meeting history — #{@endeavor.title}" %>
<%= link_to "← #{@endeavor.title}", endeavor_path(@endeavor), class: "back" %>
<h1 class="page-title">Meeting history</h1>
<p class="page-sub"><%= @endeavor.title %></p>

<div class="history-management">
  <section class="card">
    <div class="card-head"><span class="card-head-label">Search past minutes</span></div>
    <div class="card-body">
      <div class="history-search-intro">
        <p>Has the Post discussed this Endeavor before? Search older minutes to add those discussions.</p>
        <p>New work needs no search. Future minutes add updates automatically.</p>
      </div>
      <% unless EndeavorHistory::Config.enabled? %><p class="history-note">History searches are currently turned off.</p><% end %>
      <% if @endeavor.history_withdrawn? %>
        <p class="history-note">History is hidden and future updates are paused.</p>
        <%= form_with url: admin_endeavor_history_path(@endeavor), class: "stacked-form" do |form| %>
          <%= hidden_field_tag :operation, "resume" %>
          <%= hidden_field_tag :lock_version, @endeavor.lock_version %>
          <%= render "cost_confirmation" %>
          <%= form.submit "Resume and search", class: "btn-primary", disabled: !EndeavorHistory::Config.enabled? %>
        <% end %>
      <% else %>
        <%= form_with url: admin_endeavor_history_path(@endeavor), class: "stacked-form" do |form| %>
          <%= hidden_field_tag :operation, "refresh" %>
          <div class="fl">
            <%= label_tag :meeting_id, "Meetings" %>
            <%= select_tag :meeting_id, options_for_select(@sources.revisions.map { |revision| ["#{legion_date(Time.iso8601(revision.payload['starts_at']))} · #{revision.payload['meeting_body_name']}", revision.meeting_minutes.meeting_id] }), include_blank: "All meetings", class: "f" %>
          </div>
          <%= render "cost_confirmation" %>
          <%= form.submit "Search past minutes", class: "btn-primary", disabled: !EndeavorHistory::Config.enabled? || @sources.revisions.empty? %>
        <% end %>
      <% end %>
    </div>
  </section>

  <details class="history-management-options">
    <summary>More options</summary>
    <div class="history-admin-section card">
      <div class="card-head"><span class="card-head-label">Search hints</span></div>
      <div class="card-body">
        <p>Other names for this work can help find earlier discussions.</p>
        <%= form_with url: admin_endeavor_history_path(@endeavor), class: "stacked-form" do |form| %>
          <%= hidden_field_tag :operation, "guidance" %>
          <%= hidden_field_tag :lock_version, @endeavor.lock_version %>
          <div class="fl"><%= label_tag :guidance, "Other names or search hints" %><%= text_area_tag :guidance, @guidance&.body, rows: 3, maxlength: 4000, class: "f" %></div>
          <p class="history-note">Saving hints hides the current summary until you search again. Leave blank to clear hints.</p>
          <%= form.submit "Save search hints", class: "btn-primary" %>
        <% end %>
        <% unless @endeavor.history_withdrawn? %>
          <div class="history-admin-section">
            <%= button_to "Hide history and pause updates", admin_endeavor_history_path(@endeavor), params: { operation: "withdraw", lock_version: @endeavor.lock_version }, class: "btn-secondary" %>
            <p class="history-note">Meeting minutes stay available.</p>
          </div>
        <% end %>
      </div>
    </div>
    <details class="history-admin-section history-source">
      <summary>Previous summaries</summary>
      <% if @editions.empty? %><p>No saved summaries yet.</p><% end %>
      <% @editions.each do |edition| %>
        <details class="history-source">
          <summary><%= legion_datetime(edition.created_at) %></summary>
          <% edition.payload.fetch("overview").each do |claim| %><p><%= claim["text"] %></p><% end %>
        </details>
      <% end %>
    </details>
    <details class="history-admin-section history-source">
      <summary>Technical details</summary>
      <% if @runs.empty? %><p>No processing records yet.</p><% end %>
      <% @runs.each do |run| %>
        <details class="history-source">
          <summary>Run <%= run.id %> · <%= run.status.humanize %> · <%= legion_datetime(run.created_at) %></summary>
          <p><%= run.requested_by ? "Requested by #{run.requested_by.person.full_name}" : "Automatic processing" %> · <%= pluralize(run.steps.size, "AI call") %> · <%= number_with_delimiter(run.tokens) %> tokens used or reserved</p>
          <% if @reuses[run.id].present? %><p>Reused <%= pluralize(@reuses[run.id].size, "previously completed step") %>.</p><% end %>
          <% if run.error_category %><p><%= endeavor_history_error(run.error_category) %></p><% end %>
          <% run.steps.each do |step| %>
            <p><strong><%= step["stage"].humanize %></strong> · <%= step["model"] || run.manifest.dig("configuration", "model") %> · <%= step["reasoning"] %> reasoning</p>
            <% if step.dig("data", "issues").present? %><ul><% step["data"]["issues"].each do |issue| %><li><%= issue["message"] %></li><% end %></ul><% end %>
          <% end %>
          <details class="history-source"><summary>Inspect source manifest and results</summary><pre class="history-json"><%= JSON.pretty_generate({ manifest: run.manifest, steps: run.steps }) %></pre></details>
        </details>
      <% end %>
    </details>
    <p class="history-note"><%= link_to "All Endeavor histories", admin_endeavors_path, class: "lnk" %></p>
  </details>
</div>
