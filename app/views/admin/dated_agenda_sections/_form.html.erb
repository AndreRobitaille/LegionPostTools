<% form_url = section.persisted? ? admin_dated_agenda_agenda_section_path(dated_agenda, section) : admin_dated_agenda_agenda_sections_path(dated_agenda) %>
<%= form_with model: section, url: form_url, class: "stacked-form" do |form| %>
  <% if section.errors.any? %>
    <div class="error-summary">
      <h2><%= pluralize(section.errors.count, "error") %> prohibited this section from being saved:</h2>
      <ul><% section.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <%= form.hidden_field :lock_version if section.persisted? %>
  <p class="form-help">Use a short name that will also make sense to members reading the published agenda.</p>
  <div class="fl">
    <%= form.label :title, "Section name" %>
    <%= form.text_field :title, class: "f", autofocus: true, autocomplete: "off" %>
  </div>
  <div class="btnrow">
    <%= form.submit section.persisted? ? "Save section" : "Add section", class: "btn-primary" %>
    <%= link_to "Cancel", edit_admin_dated_agenda_path(dated_agenda), class: "btn-secondary" %>
  </div>
<% end %>
