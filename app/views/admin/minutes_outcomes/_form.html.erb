<% form_url = outcome.persisted? ? admin_meeting_minutes_outcome_path(meeting, outcome) : admin_meeting_minutes_outcomes_path(meeting, minutes_item_id: outcome.minutes_item_id) %>
<%= form_with model: outcome, url: form_url, class: "stacked-form minutes-editor-form" do |form| %>
  <% if outcome.errors.any? %>
    <div class="error-summary" role="alert">
      <h2>The outcome could not be saved:</h2>
      <ul><% outcome.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <%= form.hidden_field :lock_version if outcome.persisted? %>
  <div class="fl">
    <%= form.label :kind, "Outcome kind" %>
    <%= form.select :kind, MinutesOutcome::KINDS.map { |value| [ value.humanize, value ] }, {}, class: "f" %>
  </div>
  <div class="fl">
    <%= form.label :text, "What was moved or decided" %>
    <%= form.text_area :text, class: "f", rows: 5, required: true, autofocus: true %>
    <span class="fl-help">Use factual wording. Do not fill in a mover, second, vote, or result that the source does not establish.</span>
  </div>
  <div class="minutes-outcome-name-grid">
    <div class="fl">
      <%= form.label :mover_name, "Mover (if recorded)" %>
      <%= form.text_field :mover_name, class: "f" %>
    </div>
    <div class="fl">
      <%= form.label :seconder_name, "Seconder (if recorded)" %>
      <%= form.text_field :seconder_name, class: "f" %>
    </div>
  </div>
  <div class="fl">
    <%= form.label :disposition, "Recorded result" %>
    <%= form.select :disposition, MinutesOutcome::DISPOSITIONS.map { |value| [ value.humanize, value ] }, {}, class: "f" %>
    <span class="fl-help"><strong>Not recorded</strong> is the correct choice when the result cannot be established.</span>
  </div>
  <div class="fl">
    <%= form.label :vote_summary, "Vote wording (optional)" %>
    <%= form.text_field :vote_summary, class: "f", placeholder: "For example: unanimous or 7–2" %>
  </div>
  <div class="btnrow">
    <%= form.submit outcome.persisted? ? "Save outcome" : "Add outcome", class: "btn-primary" %>
    <%= link_to "Cancel", admin_meeting_minutes_path(meeting), class: "btn-secondary" %>
  </div>
<% end %>
