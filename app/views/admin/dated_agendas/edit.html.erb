<% content_for :title, @dated_agenda.title %>
<a class="back" href="<%= admin_dated_agendas_path %>">&larr; Dated Agendas</a>

<div class="page-lead-row">
  <div class="page-lead">
    <h1 class="page-title"><%= @dated_agenda.title %></h1>
    <p class="page-sub"><%= @dated_agenda.meeting_body.name %> &middot; <%= legion_datetime(@dated_agenda.starts_at) %></p>
  </div>
</div>

<%# Status and the actions that change it stay together, next to the record
    they describe — never a status on one side of the page and its action on
    the other. %>
<div class="da-lifecycle">
  <div class="da-lifecycle-state">
    <%= dated_agenda_status_tag(@dated_agenda.status) %>
    <% if @dated_agenda.locked_for_editing? %>
      <span class="helper">Locked. Reopen it to make changes.</span>
    <% end %>
  </div>
  <div class="btnrow">
    <% if @dated_agenda.draft? %>
      <%= button_to "Approve", approve_admin_dated_agenda_path(@dated_agenda), method: :patch, class: "btn-primary" %>
    <% elsif @dated_agenda.approved? %>
      <%= button_to "Publish", publish_admin_dated_agenda_path(@dated_agenda), method: :patch, class: "btn-confirm" %>
      <%= button_to "Reopen for editing", reopen_admin_dated_agenda_path(@dated_agenda), method: :patch, class: "btn-secondary", data: { turbo_confirm: "Reopen this approved agenda for editing?" } %>
    <% else %>
      <%= button_to "Reopen for editing", reopen_admin_dated_agenda_path(@dated_agenda), method: :patch, class: "btn-secondary", data: { turbo_confirm: "Reopen this published agenda for editing? This will unpublish it until you publish again." } %>
    <% end %>
    <%= link_to "Print member agenda", print_admin_dated_agenda_path(@dated_agenda), class: "btn-secondary" %>
    <%= link_to "Commander's copy", commander_admin_dated_agenda_path(@dated_agenda), class: "btn-secondary btn-commander-copy" %>
  </div>
</div>

<section class="agenda-build-section agenda-build-section--form">
  <%= render "shared/section_header", label: "Meeting details" %>
  <%= render "form", dated_agenda: @dated_agenda %>
</section>

<section class="agenda-build-section">
  <%= render "shared/section_header",
        label: @dated_agenda.draft? ? "Order of business" : "Meeting order",
        meta: pluralize(@agenda_sections.size, "section"),
        action: (@dated_agenda.draft? ? link_to("Add a section", new_admin_dated_agenda_agenda_section_path(@dated_agenda), class: "sec-head-action") : nil) %>

  <% if @dated_agenda.draft? %>
    <p class="agenda-build-hint">Drag a section by its grip to change the meeting order, or drag items within a section. Changes save as you go.</p>
    <div data-controller="reorder"
         data-reorder-url-value="<%= reorder_admin_dated_agenda_agenda_sections_path(@dated_agenda) %>"
         data-reorder-handle-value=".section-handle">
      <div class="agenda-sections" data-reorder-target="list">
        <% @agenda_sections.each_with_index do |agenda_section, index| %>
          <%= render "agenda_section", dated_agenda: @dated_agenda, agenda_section: agenda_section, section_number: index + 1, section_count: @agenda_sections.size, editable: true %>
        <% end %>
      </div>
      <span class="pos-status section-order-status" data-reorder-target="status" role="status" aria-live="polite"></span>
    </div>
  <% else %>
    <p class="agenda-build-hint">This section order is part of the locked agenda.</p>
    <div class="agenda-sections">
      <% @agenda_sections.each_with_index do |agenda_section, index| %>
        <%= render "agenda_section", dated_agenda: @dated_agenda, agenda_section: agenda_section, section_number: index + 1, section_count: @agenda_sections.size, editable: false %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="da-danger-zone" data-controller="confirm-dialog" aria-labelledby="delete-agenda-heading">
  <div>
    <h2 class="da-danger-title" id="delete-agenda-heading">Delete dated agenda</h2>
    <p class="da-danger-copy">Permanently remove this agenda when it is no longer needed.</p>
  </div>
  <button type="button"
          class="btn-return da-delete-trigger"
          data-confirm-dialog-target="trigger"
          data-action="confirm-dialog#open">Delete dated agenda</button>

  <dialog class="confirm-dialog"
          data-confirm-dialog-target="dialog"
          data-action="click->confirm-dialog#closeOnBackdrop cancel->confirm-dialog#cancel"
          aria-labelledby="delete-agenda-dialog-title"
          aria-describedby="delete-agenda-dialog-description">
    <div class="confirm-dialog-card">
      <span class="confirm-dialog-kicker">Permanent action</span>
      <h2 class="confirm-dialog-title" id="delete-agenda-dialog-title">Delete this dated agenda?</h2>
      <p class="confirm-dialog-copy" id="delete-agenda-dialog-description">
        The agenda, its sections, and its agenda items will be permanently deleted. This cannot be recovered.
      </p>

      <div class="confirm-record" aria-label="Agenda record to delete">
        <span class="confirm-record-label">Agenda record</span>
        <strong class="confirm-record-title"><%= @dated_agenda.title %></strong>
        <span class="confirm-record-meta">
          <%= @dated_agenda.meeting_body.name %> &middot;
          <%= legion_datetime(@dated_agenda.starts_at) %> &middot;
          <%= @dated_agenda.status.humanize %>
        </span>
      </div>

      <% if @dated_agenda.published? %>
        <p class="confirm-dialog-alert">Members will immediately lose access to this published agenda.</p>
      <% end %>

      <div class="confirm-dialog-actions">
        <button type="button"
                class="btn-secondary"
                data-confirm-dialog-target="cancel"
                data-action="confirm-dialog#close">Cancel</button>
        <%= button_to "Delete dated agenda", admin_dated_agenda_path(@dated_agenda), method: :delete, class: "btn-danger" %>
      </div>
    </div>
  </dialog>
</section>
