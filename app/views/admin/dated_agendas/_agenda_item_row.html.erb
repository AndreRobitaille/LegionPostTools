<div class="agenda-item-row"
     <% if editable %>data-reorder-item data-reorder-id="<%= item.id %>" data-controller="confirm-dialog"<% end %>>
  <% if editable %>
    <%= render "shared/drag_handle", label: item.title %>
  <% end %>
  <div class="agenda-item-copy">
    <span class="agenda-item-name"><%= item.title %></span>
    <% if item.summary.present? %><span class="agenda-item-note"><%= item.summary %></span><% end %>
    <%= render "admin/shared/agenda_item_status_flags", item: item %>
    <% if item.endeavor.present? %>
      <%= link_to "Endeavor", endeavor_path(item.endeavor), class: "section-item-source" %>
    <% end %>
    <% if item.roll_call? %>
      <span class="agenda-roll-call-count"><%= pluralize(item.roll_call_entries.size, "officer row") %> for this meeting</span>
    <% end %>
  </div>
  <% if editable %>
    <div class="agenda-item-actions">
      <% if item.roll_call? %>
        <%= link_to "Edit officer list",
              edit_admin_dated_agenda_agenda_item_roll_call_path(dated_agenda, item),
              class: "section-action" %>
        <%= button_to "Reload assigned officers",
              refresh_roll_call_admin_dated_agenda_agenda_item_path(dated_agenda, item),
              method: :patch,
              class: "section-action",
              data: { turbo_confirm: "Replace this meeting's officer list with assignments active on the meeting date? Any changes made only for this agenda will be lost." } %>
      <% end %>
      <%= link_to "Edit", edit_admin_dated_agenda_agenda_item_path(dated_agenda, item), class: "catrow-edit" %>
      <button type="button"
              class="row-del"
              aria-label="Remove <%= item.title %>"
              data-confirm-dialog-target="trigger"
              data-action="confirm-dialog#open">
        <%= render "shared/trash_icon" %>
      </button>
      <%= render "agenda_item_delete_confirmation_dialog",
            dated_agenda: dated_agenda,
            item: item,
            dialog_id: "remove-dated-agenda-item-#{item.id}" %>
    </div>
  <% end %>
</div>
