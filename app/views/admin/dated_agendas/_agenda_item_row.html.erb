<div class="agenda-item-row" <% if editable %>data-reorder-item data-reorder-id="<%= item.id %>"<% end %>>
  <% if editable %>
    <%= render "shared/drag_handle", label: item.title %>
  <% end %>
  <div class="agenda-item-copy">
    <span class="agenda-item-name"><%= item.title %></span>
    <% if item.summary.present? %><span class="agenda-item-note"><%= item.summary %></span><% end %>
    <% if item.tracked_item.present? %>
      <%= link_to "Tracked business", tracked_item_path(item.tracked_item), class: "section-item-source" %>
    <% end %>
  </div>
  <% if editable %>
    <div class="agenda-item-actions">
      <%= link_to "Edit", edit_admin_dated_agenda_agenda_item_path(dated_agenda, item), class: "catrow-edit" %>
      <%= button_to admin_dated_agenda_agenda_item_path(dated_agenda, item), method: :delete, class: "row-del",
            aria: { label: "Remove #{item.title}" },
            data: { turbo_confirm: "Remove “#{item.title}” from this agenda?" } do %>
        <%= render "shared/trash_icon" %>
      <% end %>
    </div>
  <% end %>
</div>
