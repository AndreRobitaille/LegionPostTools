<% content_for :title, "Dated Agendas" %>
<a class="back" href="<%= admin_root_path %>">&larr; Administration</a>

<div class="page-lead">
  <h1 class="page-title">Dated Agendas</h1>
  <p class="page-sub">Agendas for specific meeting dates, built from your meeting type templates.</p>
</div>

<div class="btnrow">
  <%= link_to "New dated agenda", new_admin_dated_agenda_path, class: "btn-primary" %>
</div>

<% if @dated_agendas.any? %>
  <div class="mrow-list">
    <% @dated_agendas.each do |dated_agenda| %>
      <div class="mrow catrow" data-controller="confirm-dialog">
        <%= link_to edit_admin_dated_agenda_path(dated_agenda), class: "mrow-id", aria: { label: "Open #{dated_agenda.title}" } do %>
          <span class="mrow-name"><%= dated_agenda.title %></span>
          <span class="mrow-sub"><%= dated_agenda.meeting_body.name %> &middot; <%= legion_datetime(dated_agenda.starts_at) %></span>
        <% end %>
        <div class="catrow-meta">
          <%= dated_agenda_status_tag(dated_agenda.status) %>
          <%= link_to edit_admin_dated_agenda_path(dated_agenda), class: "catrow-edit", aria: { label: "Open #{dated_agenda.title}" } do %>
            Open<span class="catrow-caret" aria-hidden="true">&rsaquo;</span>
          <% end %>
          <button type="button"
                  class="row-del"
                  aria-label="Delete <%= dated_agenda.title %>"
                  data-confirm-dialog-target="trigger"
                  data-action="confirm-dialog#open">
            <%= render "shared/trash_icon" %>
          </button>
          <%= render "delete_confirmation_dialog",
                dated_agenda: dated_agenda,
                dialog_id: "delete-dated-agenda-#{dated_agenda.id}" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="page-sub">No dated agendas yet. Create one to prepare for an upcoming meeting.</p>
<% end %>
