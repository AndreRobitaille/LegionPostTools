<article class="card agenda-section" <% if editable %>data-reorder-item data-reorder-id="<%= agenda_section.id %>"<% end %>>
  <header class="card-head">
    <% if editable %>
      <%= render "shared/drag_handle", label: agenda_section.title, extra_class: "section-handle" %>
    <% end %>
    <span class="agenda-section-num" aria-hidden="true"><%= section_number %></span>
    <h3 class="agenda-section-name"><%= agenda_section.title %></h3>
    <span class="agenda-section-count"><%= pluralize(agenda_section.agenda_items.count(&:active?), "item") %></span>
    <% if editable %>
      <div class="agenda-section-actions">
        <% if section_number > 1 %>
          <%= button_to "Move up", move_admin_dated_agenda_agenda_section_path(dated_agenda, agenda_section, direction: "up"), method: :patch,
                class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} up" } %>
        <% end %>
        <% if section_number < section_count %>
          <%= button_to "Move down", move_admin_dated_agenda_agenda_section_path(dated_agenda, agenda_section, direction: "down"), method: :patch,
                class: "section-action section-action--move", aria: { label: "Move #{agenda_section.title} down" } %>
        <% end %>
        <%= link_to "Rename", edit_admin_dated_agenda_agenda_section_path(dated_agenda, agenda_section), class: "section-action" %>
        <% if agenda_section.agenda_items.empty? && section_count > 1 %>
          <%= button_to "Remove", admin_dated_agenda_agenda_section_path(dated_agenda, agenda_section), method: :delete,
                class: "section-action section-action--danger",
                data: { turbo_confirm: "Remove the empty “#{agenda_section.title}” section?" } %>
        <% end %>
      </div>
    <% end %>
  </header>

  <div class="card-body">
    <% items = agenda_section.agenda_items.select(&:active?) %>
    <% if items.any? %>
      <% if editable %>
        <div data-controller="reorder" data-reorder-url-value="<%= reorder_admin_dated_agenda_agenda_items_path(dated_agenda, dated_agenda_section_id: agenda_section.id) %>">
          <div class="agenda-items" data-reorder-target="list">
            <% items.each do |item| %>
              <%= render "admin/dated_agendas/agenda_item_row", dated_agenda: dated_agenda, item: item, editable: true %>
            <% end %>
          </div>
          <span class="pos-status section-order-status" data-reorder-target="status" role="status" aria-live="polite"></span>
        </div>
      <% else %>
        <div class="agenda-items">
          <% items.each do |item| %>
            <%= render "admin/dated_agendas/agenda_item_row", dated_agenda: dated_agenda, item: item, editable: false %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="agenda-section-empty">
        <span class="agenda-section-empty-mark" aria-hidden="true">&#9671;</span>
        <div>
          <strong>Nothing in this section yet</strong>
          <% if editable %>Add an item from the Post’s agenda catalog, or bring forward a continuing Endeavor.<% end %>
        </div>
      </div>
    <% end %>

    <% if editable %>
      <div class="agenda-section-foot">
        <%= link_to new_admin_dated_agenda_agenda_item_path(dated_agenda, dated_agenda_section_id: agenda_section.id), class: "section-add" do %>
          <span class="section-add-mark" aria-hidden="true">&#43;</span> Add catalog item
        <% end %>
        <%= link_to new_admin_dated_agenda_endeavor_path(dated_agenda, dated_agenda_section_id: agenda_section.id), class: "section-add" do %>
          <span class="section-add-mark" aria-hidden="true">&#9670;</span> Add Endeavor
        <% end %>
      </div>
    <% end %>
  </div>
</article>
