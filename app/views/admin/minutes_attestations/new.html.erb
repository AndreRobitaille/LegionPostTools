<% finalizing = @minutes.pending_correction_approval.present? %>
<% action_label = finalizing ? "Confirm corrections and lock minutes" : "Attest and share with members" %>
<% content_for :title, action_label %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead">
  <p class="minutes-eyebrow">Adjutant attestation</p>
  <h1 class="page-title"><%= action_label %></h1>
  <p class="page-sub"><%= @minutes.title %></p>
</div>

<section class="official-confirmation-summary">
  <h2><%= finalizing ? "Approve the final corrected copy" : "Confirm the record you reviewed" %></h2>
  <% if finalizing %>
    <p>You confirm that the corrections approved at the meeting are incorporated in this copy. It becomes the official approved record and can no longer be edited.</p>
    <p>The meeting's approval has already been recorded. No second vote is needed.</p>
  <% else %>
    <p>You attest that the current text is the minutes record you reviewed. This is your electronic attestation; no handwritten signature is needed.</p>
    <p>Members can then read this exact copy. It remains awaiting approval at a later meeting.</p>
  <% end %>
</section>

<%= button_to action_label, admin_meeting_minutes_attestation_path(@meeting),
      params: ({ confirmation_id: @confirmation.id } if @confirmation), class: "btn-confirm" %>
<p class="helper">Confirm your identity next. That completes this action.</p>
