<% content_for :title, "Send minutes to Adjutant" %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead">
  <h1 class="page-title">Send this draft to the Adjutant</h1>
  <p class="page-sub"><%= @minutes.title %></p>
</div>

<section class="official-confirmation-summary">
  <h2>Ready for Adjutant review</h2>
  <p>This preserves your draft and hands it to the Adjutant for review. The Adjutant can edit it and attest the finished copy without sending it back to you.</p>
  <p>Members will see the minutes after the Adjutant attests them.</p>
</section>

<%= button_to "Send to Adjutant", admin_meeting_minutes_approval_path(@meeting),
      params: ({ confirmation_id: @confirmation.id } if @confirmation), class: "btn-confirm" %>
<p class="helper">Confirm your identity next. That completes the handoff.</p>
