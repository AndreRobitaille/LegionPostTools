<% form_url = section.persisted? ? admin_meeting_minutes_section_path(meeting, section) : admin_meeting_minutes_sections_path(meeting) %>
<%= form_with model: section, url: form_url, class: "stacked-form minutes-editor-form" do |form| %>
  <% if section.errors.any? %>
    <div class="error-summary" role="alert">
      <h2>The section could not be saved:</h2>
      <ul><% section.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <%= form.hidden_field :lock_version if section.persisted? %>
  <div class="fl">
    <%= form.label :title, "Section name" %>
    <%= form.text_field :title, class: "f", required: true, autofocus: true %>
    <span class="fl-help">Use the heading members should see in the minutes.</span>
  </div>
  <div class="btnrow">
    <%= form.submit section.persisted? ? "Save section" : "Add section", class: "btn-primary" %>
    <%= link_to "Cancel", admin_meeting_minutes_path(meeting), class: "btn-secondary" %>
  </div>
<% end %>
