<% content_for :title, "Review minutes draft — #{@meeting.title}" %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead-row ai-review-lead">
  <div class="page-lead">
    <p class="minutes-eyebrow">AI working suggestions &middot; not minutes</p>
    <h1 class="page-title">Review the first pass</h1>
    <p class="page-sub"><%= @meeting.title %></p>
  </div>
  <%= render "review_counter", run: @run %>
</div>

<% if @run.failed? %>
  <section class="ai-draft-failure" role="alert">
    <p class="meeting-workflow-kicker">Draft not created</p>
    <h2>The working minutes are unchanged.</h2>
    <p><%= minutes_draft_error_message(@run) %></p>
    <div class="btnrow">
      <%= link_to "Try again", new_admin_meeting_minutes_draft_run_path(@meeting), class: "btn-primary" %>
      <%= link_to "Continue manually", admin_meeting_minutes_path(@meeting), class: "btn-secondary" %>
    </div>
  </section>
<% elsif @run.succeeded? %>
  <div class="ai-review-layout">
    <main class="ai-suggestion-ledger" aria-labelledby="suggestion-ledger-heading">
      <div class="ai-suggestion-ledger-head">
        <div>
          <p class="meeting-workflow-kicker">Adjutant review ledger</p>
          <h2 id="suggestion-ledger-heading">Check every proposed fact</h2>
        </div>
        <p>Review attendance as one officer sheet, then use, edit, or discard each remaining proposal.</p>
      </div>

      <% if @attendance_entries.any? %>
        <%= render "attendance_sheet",
          run: @run,
          meeting: @meeting,
          attendance_entries: @attendance_entries,
          suggestions_by_entry_id: @attendance_suggestions_by_entry_id,
          saved: false,
          error: nil %>
      <% end %>

      <% if @suggestions.any? %>
        <%= render partial: "suggestion_card",
          collection: @suggestions,
          as: :suggestion,
          locals: { meeting: @meeting, source_document: @source_document, inline_error: nil } %>
      <% elsif @attendance_entries.empty? %>
        <div class="ai-no-suggestions">
          <h3>No source-supported suggestions were returned.</h3>
          <p>The working minutes remain available for manual editing. This is safer than filling gaps from an uncertain transcript.</p>
        </div>
      <% else %>
        <div class="ai-no-suggestions ai-no-suggestions--compact">
          <h3>No other suggestions to review.</h3>
          <p>Finish the officer attendance sheet above, or return to the working minutes.</p>
        </div>
      <% end %>
    </main>

    <aside class="ai-run-facts" aria-labelledby="ai-run-facts-heading">
      <p class="meeting-workflow-kicker">Run provenance</p>
      <h2 id="ai-run-facts-heading">Draft record</h2>
      <dl>
        <div><dt>Model</dt><dd><%= @run.model %></dd></div>
        <div><dt>Reasoning</dt><dd><%= @run.reasoning_effort %></dd></div>
        <div><dt>Draft detail</dt><dd><%= @run.text_verbosity %></dd></div>
        <div><dt>Prompt</dt><dd><%= @run.prompt_version %></dd></div>
        <div><dt>Source</dt><dd><%= number_with_delimiter(@run.source_line_count) %> numbered lines</dd></div>
        <% if @run.total_tokens %><div><dt>Tokens</dt><dd><%= number_with_delimiter(@run.total_tokens) %> total</dd></div><% end %>
      </dl>
      <%= link_to "Open restricted transcript", admin_meeting_transcript_path(@meeting), class: "minutes-rail-link" %>
    </aside>
  </div>
<% else %>
  <section class="ai-draft-failure" role="status">
    <h2>The draft is still being prepared.</h2>
    <p>Return to this page in a moment. The working minutes are unchanged until you review suggestions.</p>
  </section>
<% end %>
