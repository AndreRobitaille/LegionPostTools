<% if @run.succeeded? %>
  <% page_title = "Review" %>
  <% eyebrow = "AI working suggestions · not minutes" %>
  <% heading = "Review the first pass" %>
<% elsif @run.failed? %>
  <% page_title = "AI draft" %>
  <% eyebrow = "AI draft dispatch · working record" %>
  <% heading = "Draft not created" %>
<% else %>
  <% page_title = "AI draft" %>
  <% eyebrow = "AI draft dispatch · working record" %>
  <% heading = "Preparing the first pass" %>
<% end %>

<% content_for :title, "#{page_title} — #{@meeting.title}" %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead-row ai-review-lead">
  <div class="page-lead">
    <p class="minutes-eyebrow"><%= eyebrow %></p>
    <h1 class="page-title"><%= heading %></h1>
    <p class="page-sub"><%= @meeting.title %></p>
  </div>
  <%= render "review_counter", run: @run if @run.succeeded? %>
</div>

<%= render "admin/minutes_outcomes/roster_data", people: @minutes_people, id: "minutes_roster_people" if @run.succeeded? %>

<% if @run.failed? %>
  <section class="ai-draft-failure" role="alert">
    <p class="meeting-workflow-kicker">Draft not created</p>
    <h2>The working minutes are unchanged.</h2>
    <p><%= minutes_draft_error_message(@run) %></p>
    <div class="btnrow">
      <%= link_to "Try again", new_admin_meeting_minutes_draft_run_path(@meeting), class: "btn-primary" %>
      <%= link_to "Continue manually", admin_meeting_minutes_path(@meeting), class: "btn-secondary" %>
    </div>
  </section>
<% elsif @run.succeeded? %>
  <div class="ai-review-layout">
    <main class="ai-suggestion-ledger" aria-labelledby="suggestion-ledger-heading">
      <div class="ai-suggestion-ledger-head">
        <div>
          <p class="meeting-workflow-kicker">Adjutant review ledger</p>
          <h2 id="suggestion-ledger-heading">Check every proposed fact</h2>
        </div>
        <p>Review attendance as one officer sheet, then use, edit, or discard each remaining proposal.</p>
      </div>

      <% if @attendance_entries.any? %>
        <%= render "attendance_sheet",
          run: @run,
          meeting: @meeting,
          attendance_entries: @attendance_entries,
          suggestions_by_entry_id: @attendance_suggestions_by_entry_id,
          saved: false,
          error: nil %>
      <% end %>

      <% if @suggestions.any? %>
        <%= render partial: "suggestion_card",
          collection: @suggestions,
          as: :suggestion,
          locals: {
            meeting: @meeting,
            source_document: @source_document,
            inline_error: nil,
            people: @minutes_people,
            submitted_values: {}
          } %>
      <% elsif @attendance_entries.empty? %>
        <div class="ai-no-suggestions">
          <h3>No source-supported suggestions were returned.</h3>
          <p>The working minutes remain available for manual editing. This is safer than filling gaps from an uncertain transcript.</p>
        </div>
      <% else %>
        <div class="ai-no-suggestions ai-no-suggestions--compact">
          <h3>No other suggestions to review.</h3>
          <p>Finish the officer attendance sheet above, or return to the working minutes.</p>
        </div>
      <% end %>
    </main>

    <aside class="ai-run-facts" aria-labelledby="ai-run-facts-heading">
      <p class="meeting-workflow-kicker">Run provenance</p>
      <h2 id="ai-run-facts-heading">Draft record</h2>
      <dl>
        <div><dt>Model</dt><dd><%= @run.model %></dd></div>
        <div><dt>Reasoning</dt><dd><%= @run.reasoning_effort %></dd></div>
        <div><dt>Draft detail</dt><dd><%= @run.text_verbosity %></dd></div>
        <div><dt>Prompt</dt><dd><%= @run.prompt_version %></dd></div>
        <div><dt>Source</dt><dd><%= number_with_delimiter(@run.source_line_count) %> numbered lines</dd></div>
        <% if @run.total_tokens %><div><dt>Tokens</dt><dd><%= number_with_delimiter(@run.total_tokens) %> total</dd></div><% end %>
      </dl>
      <%= link_to "Open restricted transcript", admin_meeting_transcript_path(@meeting), class: "minutes-rail-link" %>
    </aside>
  </div>
<% else %>
  <section
    class="ai-draft-dispatch"
    data-controller="draft-run-monitor"
    data-state="<%= @run.status %>"
    data-draft-run-monitor-status-url-value="<%= status_admin_meeting_minutes_draft_run_path(@meeting, @run, format: :json) %>"
    data-draft-run-monitor-destination-url-value="<%= admin_meeting_minutes_draft_run_path(@meeting, @run) %>"
    aria-labelledby="draft-dispatch-heading">
    <header class="ai-draft-dispatch-head">
      <div>
        <p class="meeting-workflow-kicker">Background draft</p>
        <h2 id="draft-dispatch-heading" data-draft-run-monitor-target="heading"><%= @run.running? ? "OpenAI is preparing suggestions" : "Your draft is in line" %></h2>
      </div>
      <span class="ai-draft-dispatch-badge" data-draft-run-monitor-target="badge"><%= @run.running? ? "Drafting" : "Queued" %></span>
    </header>

    <p class="ai-draft-dispatch-message" data-draft-run-monitor-target="message" aria-live="polite">
      <%= @run.running? ? "OpenAI is organizing source-linked suggestions. This can take up to several minutes." : "The request is recorded and waiting for the background drafting worker." %>
    </p>

    <ol class="ai-draft-dispatch-track" aria-label="Draft progress">
      <li class="is-complete">
        <span>1</span>
        <div><strong>Request received</strong><small><%= time_tag @run.created_at, @run.created_at.in_time_zone(@meeting.organization.timezone).strftime("%-I:%M %p") %></small></div>
      </li>
      <li class="is-active">
        <span>2</span>
        <div><strong data-draft-run-monitor-target="stageTitle"><%= @run.running? ? "Preparing suggestions" : "Waiting for worker" %></strong><small>Agenda and transcript stay protected</small></div>
      </li>
      <li>
        <span>3</span>
        <div><strong>Human review</strong><small>Nothing enters the minutes automatically</small></div>
      </li>
    </ol>

    <div class="ai-draft-dispatch-note">
      <strong>You do not need to keep this page open.</strong>
      <p>The work continues in the background. Return from the minutes workspace at any time to check this run.</p>
    </div>

    <div class="ai-draft-dispatch-actions">
      <button type="button" class="btn-secondary" data-draft-run-monitor-target="checkButton" data-action="draft-run-monitor#checkNow">Check status now</button>
      <%= link_to "Return to minutes", admin_meeting_minutes_path(@meeting), class: "ai-draft-dispatch-return" %>
    </div>
    <noscript><p class="ai-draft-dispatch-noscript">Automatic status checks require JavaScript. Refresh this page to check the draft.</p></noscript>
  </section>
<% end %>
