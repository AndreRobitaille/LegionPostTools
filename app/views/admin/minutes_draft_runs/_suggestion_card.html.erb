<%= turbo_frame_tag dom_id(suggestion, :review) do %>
  <article class="ai-suggestion-card ai-suggestion-card--<%= suggestion.review_state %>" aria-labelledby="suggestion-<%= suggestion.id %>-heading">
    <div class="ai-suggestion-source-ribbon">
      <span>Source</span>
      L<%= format("%04d", suggestion.source_start_line) %><% if suggestion.source_end_line != suggestion.source_start_line %>–L<%= format("%04d", suggestion.source_end_line) %><% end %>
    </div>
    <div class="ai-suggestion-heading">
      <div>
        <p><%= minutes_suggestion_kind_label(suggestion) %> &middot; <%= suggestion.confidence.capitalize %> confidence</p>
        <h3 id="suggestion-<%= suggestion.id %>-heading"><%= minutes_suggestion_target_label(suggestion) %></h3>
      </div>
      <span class="ai-review-state ai-review-state--<%= suggestion.review_state %>"><%= minutes_suggestion_review_label(suggestion) %></span>
    </div>

    <% if inline_error.present? %>
      <p class="ai-inline-error" role="alert"><%= inline_error %></p>
    <% end %>

    <div class="ai-suggestion-proposal"><%= simple_format(minutes_suggestion_proposal(suggestion)) %></div>

    <% if (endeavor_label = minutes_suggestion_endeavor_label(suggestion)) %>
      <p class="ai-suggestion-endeavor"><span>Related Endeavor</span><strong><%= endeavor_label %></strong></p>
    <% end %>

    <% review_facts = minutes_suggestion_review_facts(suggestion) %>
    <% if review_facts.any? %>
      <div class="ai-missing-facts">
        <strong>Check before using</strong>
        <ul><% review_facts.each do |fact| %><li><%= fact %></li><% end %></ul>
      </div>
    <% end %>

    <details class="ai-source-evidence">
      <summary>Read supporting transcript lines</summary>
      <% if source_document %>
        <pre><%= source_document.excerpt(suggestion.source_start_line, suggestion.source_end_line) %></pre>
      <% else %>
        <p>The restricted source has been purged; this range is retained only as provenance.</p>
      <% end %>
    </details>

    <% if suggestion.unreviewed? && suggestion.kind == "outcome" %>
      <% values = submitted_values.to_h.stringify_keys %>
      <% current_disposition = minutes_review_disposition(values, suggestion.payload["disposition"]) %>
      <%= form_with url: use_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion),
            scope: :minutes_draft_suggestion,
            class: "motion-verification-form motion-record-shell" do |form| %>
        <div class="motion-record-heading">
          <h4>Motion record</h4>
          <p>Confirm the outcome and the people named in the record.</p>
        </div>
        <%= render "admin/minutes_outcomes/verification_fields",
          form: form,
          scope_id: "suggestion_#{suggestion.id}",
          people: people,
          current_disposition: current_disposition,
          suggested_disposition: suggestion.payload["disposition"],
          mover_person_id: values["mover_person_id"],
          seconder_person_id: values["seconder_person_id"],
          suggested_mover_name: suggestion.payload["mover_name"],
          suggested_seconder_name: suggestion.payload["seconder_name"],
          source_label: "AI heard",
          roster_source_id: "minutes_roster_people",
          show_mover_picker: true,
          show_seconder_picker: true,
          mover_unidentified: values["mover_unidentified"],
          seconder_unidentified: values["seconder_unidentified"] %>
        <div class="ai-motion-primary-action"><%= form.submit "Add motion", class: "btn-primary" %></div>
      <% end %>
      <div class="ai-suggestion-actions ai-suggestion-actions--secondary">
        <%= link_to "Edit wording and details", edit_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion), class: "btn-secondary", data: { turbo_frame: "_top" } %>
        <%= button_to "Discard", discard_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion), method: :post, class: "ai-discard-button" %>
      </div>
    <% elsif suggestion.unreviewed? %>
      <div class="ai-suggestion-actions">
        <%= button_to (suggestion.kind == "item_summary" ? "Add to minutes" : "Use suggestion"), use_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion), method: :post, class: "btn-primary" %>
        <%= link_to "Edit before using", edit_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion), class: "btn-secondary", data: { turbo_frame: "_top" } %>
        <%= button_to "Discard", discard_admin_meeting_minutes_draft_suggestion_path(meeting, suggestion), method: :post, class: "ai-discard-button" %>
      </div>
    <% else %>
      <div class="ai-suggestion-complete ai-suggestion-complete--<%= suggestion.review_state %>" role="status">
        <strong><%= minutes_suggestion_review_label(suggestion) %></strong>
        <span>Reviewed <%= legion_datetime(suggestion.reviewed_at) %> by <%= suggestion.reviewed_by.person.full_name %>.</span>
      </div>
    <% end %>
  </article>
<% end %>
