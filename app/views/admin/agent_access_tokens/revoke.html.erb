<% content_for :title, "Revoke agent token" %>

<div class="page-lead">
  <h1 class="page-title">Revoke <%= @agent_access_token.name %>?</h1>
  <p class="page-sub">Owned by <%= @agent_access_token.user.person.full_name %>. The next request will be refused.</p>
</div>

<section class="profile-section agent-access-section">
  <div class="panel">
    <p class="panel-lead">Use this for incident response or when the owner can no longer revoke the token.</p>
    <div class="btnrow">
      <%= button_to "Revoke token", admin_agent_access_token_path(@agent_access_token), method: :delete, class: "btn-return" %>
      <%= link_to "Keep token", admin_agent_access_tokens_path, class: "btn-secondary" %>
    </div>
  </div>
</section>
