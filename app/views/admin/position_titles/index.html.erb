<% content_for :title, "Post Positions" %>

<div class="page-lead">
  <h1 class="page-title">Post Positions</h1>
  <p class="page-sub">The offices your post fills, their wording, order, and automatic app duties.</p>
</div>

<%= render "shared/section_panel", label: "Post Positions" do %>
  <% if @position_titles.present? %>
    <p class="page-sub" id="reorder-hint">Drag a row by its handle to change the order. Changes save automatically.</p>
    <p class="position-access-note">Automatic access begins and ends with a dated assignment. The gold markers show what a current office supplies.</p>
    <div data-controller="reorder"
         data-reorder-url-value="<%= reorder_admin_position_titles_path %>">
      <div data-reorder-target="list">
        <% @position_titles.each do |title| %>
          <div class="pos" data-reorder-item data-reorder-id="<%= title.id %>">
            <button type="button" class="pos-handle" aria-label="Drag to reorder <%= title.name %>">
              <svg width="12" height="18" viewBox="0 0 12 18" aria-hidden="true" focusable="false">
                <g fill="currentColor">
                  <circle cx="3" cy="3" r="1.6"/><circle cx="9" cy="3" r="1.6"/>
                  <circle cx="3" cy="9" r="1.6"/><circle cx="9" cy="9" r="1.6"/>
                  <circle cx="3" cy="15" r="1.6"/><circle cx="9" cy="15" r="1.6"/>
                </g>
              </svg>
            </button>
            <div class="pos-main">
              <span class="pn"><%= title.name %></span>
              <% if title.grants_full_membership_access? %>
                <span class="pos-access"><span aria-hidden="true">&#9670;</span> Full membership access</span>
              <% end %>
              <% title.position_capability_grants.sort_by { |grant| PermissionGrant::CAPABILITIES.index(grant.capability) || 99 }.each do |grant| %>
                <span class="pos-access"><span aria-hidden="true">&#9670;</span> <%= PermissionGrant::LABELS.fetch(grant.capability, grant.capability.humanize) %></span>
              <% end %>
            </div>
            <div class="pos-actions">
              <span class="state <%= title.active? ? "on" : "off" %>"><%= title.active? ? "Active" : "Inactive" %></span>
              <%= button_to title.active? ? "Deactivate" : "Activate", admin_position_title_path(title), method: :patch,
                    params: { position_title: { active: !title.active? } }, class: "toggle", form: { class: "posform" } %>
              <%= button_to title.grants_full_membership_access? ? "Remove membership access" : "Grant membership access",
                    admin_position_title_path(title), method: :patch,
                    params: { position_title: { grants_full_membership_access: !title.grants_full_membership_access? } },
                    class: "toggle", form: { class: "posform" } %>
            </div>
          </div>
        <% end %>
      </div>
      <span class="pos-status" data-reorder-target="status" role="status" aria-live="polite"></span>
    </div>
  <% else %>
    <p class="page-sub">No post positions yet.</p>
  <% end %>

  <div class="addrow">
    <%= form_with url: admin_position_titles_path, method: :post, scope: :position_title do |form| %>
      <div class="fl">
        <%= form.label :name, "Position name" %>
        <%= form.text_field :name, class: "f" %>
      </div>
      <%= form.submit "+ Add position", class: "btn-secondary" %>
    <% end %>
  </div>
<% end %>

<p class="page-sub"><%= link_to "← Back to Administration", admin_root_path %></p>
