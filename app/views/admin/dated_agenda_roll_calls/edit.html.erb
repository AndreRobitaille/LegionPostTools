<% content_for :title, "Officers for #{@dated_agenda.title}" %>
<a class="back" href="<%= edit_admin_dated_agenda_path(@dated_agenda) %>">&larr; Back to dated agenda</a>

<div class="page-lead roll-call-editor-lead">
  <span class="roll-call-editor-date"><%= legion_date(@dated_agenda.starts_at.in_time_zone.to_date) %></span>
  <h1 class="page-title">Officer list for this meeting</h1>
  <p class="page-sub">Edit the roll-call worksheet for <%= @dated_agenda.title %>.</p>
</div>

<div class="roll-call-editor-note">
  <strong>This list belongs only to this dated agenda.</strong>
  Changes here do not alter Post roles in People or the officers used for another meeting.
</div>

<%= form_with url: admin_dated_agenda_agenda_item_roll_call_path(@dated_agenda, @item), method: :patch, scope: :roll_call, class: "roll-call-editor-form" do |form| %>
  <section class="roll-call-editor-sheet" aria-labelledby="current-officers-heading">
    <div class="roll-call-editor-heading">
      <div>
        <h2 id="current-officers-heading">Offices on this worksheet</h2>
        <p>Select Vacant to keep an empty office visible. Remove a row only when that office should not appear for this meeting.</p>
      </div>
      <span><%= pluralize(@item.roll_call_entries.size, "row") %></span>
    </div>

    <div class="roll-call-editor-columns" aria-hidden="true">
      <span>Office</span>
      <span>Officer</span>
      <span></span>
    </div>

    <div class="roll-call-editor-rows">
      <% @item.roll_call_entries.each do |entry| %>
        <div class="roll-call-editor-row">
          <div class="roll-call-editor-office">
            <span class="roll-call-editor-mobile-label">Office</span>
            <strong><%= entry.office_name %></strong>
          </div>
          <div class="fl roll-call-editor-person">
            <label class="roll-call-editor-mobile-label" for="roll-call-entry-<%= entry.id %>">Officer</label>
            <%= select_tag "roll_call[entries][#{entry.id}][person_id]",
                  options_from_collection_for_select(@people, :id, :roster_display_name, entry.person_id),
                  include_blank: "Vacant",
                  id: "roll-call-entry-#{entry.id}",
                  class: "f" %>
          </div>
          <label class="roll-call-editor-remove">
            <%= check_box_tag "roll_call[entries][#{entry.id}][remove]", "1", false %>
            <span>Remove row</span>
          </label>
        </div>
      <% end %>
    </div>
  </section>

  <section class="roll-call-editor-add" aria-labelledby="add-office-heading">
    <div>
      <h2 id="add-office-heading">Add an office</h2>
      <p>Use this when an optional or additional Post office is missing from the worksheet.</p>
    </div>
    <div class="roll-call-editor-add-fields">
      <div class="fl">
        <%= label_tag "roll_call_new_entry_position_title_id", "Post office" %>
        <%= form.collection_select :position_title_id, @position_titles, :id, :name,
              { prompt: "Choose an office…" },
              { name: "roll_call[new_entry][position_title_id]", id: "roll_call_new_entry_position_title_id", class: "f" } %>
      </div>
      <div class="fl">
        <%= label_tag "roll_call_new_entry_person_id", "Officer or vacancy" %>
        <%= form.collection_select :person_id, @people, :id, :roster_display_name,
              { include_blank: "Vacant" },
              { name: "roll_call[new_entry][person_id]", id: "roll_call_new_entry_person_id", class: "f" } %>
      </div>
    </div>
  </section>

  <div class="roll-call-editor-actions">
    <%= form.submit "Save officer list", class: "btn-primary" %>
    <%= link_to "Cancel", edit_admin_dated_agenda_path(@dated_agenda), class: "btn-secondary" %>
  </div>
<% end %>

<div class="roll-call-editor-reset">
  <div>
    <h2>Start again from Post assignments</h2>
    <p>Replace this worksheet with the people whose Post roles were active on the meeting date.</p>
  </div>
  <%= button_to "Reload assigned officers",
        refresh_roll_call_admin_dated_agenda_agenda_item_path(@dated_agenda, @item),
        method: :patch,
        class: "btn-secondary",
        data: { turbo_confirm: "Replace this meeting's officer list with assignments active on the meeting date? Any changes made only for this agenda will be lost." } %>
</div>
