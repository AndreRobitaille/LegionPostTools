<% minutes_kind = {
  "draft" => "Draft minutes",
  "approved" => "Commander-approved minutes",
  "attested" => "Attested minutes",
  "membership_approved" => "Official minutes"
}.fetch(@minutes.status) %>
<% content_for :title, "#{minutes_kind} - #{@minutes.title}" %>
<% editable = current_user.can?("manage_minutes") && @minutes.draft? %>
<% organizing = editable && params[:organize] == "1" %>
<% latest_run = @minutes.draft_runs.first %>
<% unreviewed_count = latest_run&.succeeded? ? latest_run.suggestions.unreviewed.count : 0 %>

<%= link_to admin_meeting_path(@meeting), class: "back" do %>&larr; Meeting record<% end %>

<div class="page-lead-row minutes-workspace-lead">
  <div class="page-lead">
    <p class="minutes-eyebrow">Working record &middot; officer access only</p>
    <h1 class="page-title"><%= @minutes.title %></h1>
    <p class="page-sub"><%= @minutes.meeting_body.name %> &middot; <%= legion_datetime(@minutes.starts_at) %></p>
  </div>
</div>

<div class="da-lifecycle minutes-lifecycle">
  <div class="da-lifecycle-state">
    <span class="minutes-draft-stamp<%= " minutes-draft-stamp--attested" if @minutes.attested? || @minutes.membership_approved? %>"><%= if @minutes.membership_approved?
      "Membership approved"
    elsif @minutes.attested?
      "Awaiting membership approval"
    elsif @minutes.reopened?
      "Under correction"
    else
      "#{@minutes.status.humanize} minutes"
    end %></span>
    <span class="helper">
      <% if @minutes.reopened? %>Editable correction in progress. The prior attested revision remains visible to members.
      <% elsif @minutes.draft? %>Editable working record. Not visible to members.
      <% elsif @minutes.approved? %>Commander-approved exact revision. Awaiting a different officer's Adjutant attestation.
      <% elsif @minutes.attested? %>Visible to members. Membership approval has not been recorded.
      <% else %>Official record approved by the membership.<% end %>
    </span>
  </div>
  <div class="btnrow">
    <%= link_to minutes_pdf_action_label(@minutes), print_admin_meeting_minutes_path(@meeting), class: "btn-secondary", data: { turbo: false } %>
    <% if editable %>
      <%= link_to "Edit heading", edit_admin_meeting_minutes_path(@meeting), class: "btn-secondary" %>
      <% if organizing %>
        <%= link_to "Finish organizing", admin_meeting_minutes_path(@meeting), class: "btn-primary" %>
      <% else %>
        <%= link_to "Organize record", admin_meeting_minutes_path(@meeting, organize: "1"), class: "btn-secondary" %>
      <% end %>
    <% end %>
    <% if @minutes.draft? && current_user.can?("approve_minutes") && @minutes.approval_ready? %>
      <%= link_to(@minutes.reopened? ? "Approve corrected draft for Adjutant" : "Approve exact draft for Adjutant", new_admin_meeting_minutes_approval_path(@meeting), class: "btn-confirm") %>
    <% elsif @minutes.approved? && current_user.can?("attest_minutes") && @minutes.current_revision.approved_by.person_id != current_user.person_id %>
      <%= link_to "Attest and release to members", new_admin_meeting_minutes_attestation_path(@meeting), class: "btn-confirm" %>
    <% elsif @minutes.attested? %>
      <% if current_user.can?("record_minutes_approval") %>
        <%= link_to "Record membership approval", new_admin_meeting_minutes_membership_approval_path(@meeting), class: "btn-confirm" %>
      <% end %>
      <% if current_user.can?("attest_minutes") %>
        <%= link_to "Reopen for correction", new_admin_meeting_minutes_reopening_path(@meeting), class: "btn-secondary" %>
      <% end %>
    <% elsif @minutes.approved? && current_user.can?("approve_minutes") %>
      <%= link_to "Reopen before attestation", new_admin_meeting_minutes_reopening_path(@meeting), class: "btn-secondary" %>
    <% end %>
  </div>
</div>

<section class="minutes-lifecycle-rail" aria-label="Minutes progression">
  <% approval = @minutes.reopened? ? nil : @minutes.current_revision %>
  <% attestation = approval&.attestation %>
  <div class="minutes-lifecycle-step is-complete">
    <span>1</span><div><strong>Working draft</strong><small>Human-reviewed record</small></div>
  </div>
  <div class="minutes-lifecycle-step <%= approval ? "is-complete" : (@minutes.draft? ? "is-current" : "") %>">
    <span>2</span><div><strong>Commander approval for attestation</strong><small><%= approval ? "#{approval.approver_name} · #{legion_datetime(approval.approved_at)}" : (@minutes.reopened? ? "Repeat after entering the correction" : "Approve one exact revision") %></small></div>
  </div>
  <div class="minutes-lifecycle-step <%= attestation ? "is-complete" : (@minutes.approved? ? "is-current" : "") %>">
    <span>3</span><div><strong>Adjutant release</strong><small><%= attestation ? "#{attestation.attester_name} · #{legion_datetime(attestation.attested_at)}" : "Makes the revision visible to members" %></small></div>
  </div>
  <div class="minutes-lifecycle-step <%= @minutes.membership_approved? ? "is-complete" : (@minutes.attested? ? "is-current" : "") %>">
    <span>4</span><div><strong>Membership approval</strong><small><%= if @minutes.membership_approved?
      "#{@minutes.membership_approval.disposition_label} · #{legion_date(@minutes.membership_approval.approving_meeting.starts_at)}"
    elsif @minutes.attested?
      "Awaiting action at a later meeting"
    else
      "Not reached"
    end %></small></div>
  </div>
</section>

<% if @minutes.reopened? || @minutes.revisions.many? %>
  <section class="minutes-correction-ledger" aria-labelledby="revision-history-heading">
    <p>Preserved record history</p>
    <h2 id="revision-history-heading"><%= @minutes.reopened? ? "A correction is being prepared" : "Revision history" %></h2>
    <dl>
      <% @minutes.revisions.reverse_each do |revision| %>
        <div>
          <dt>Revision <%= revision.number %></dt>
          <dd>Commander-approved by <%= revision.approver_name %><% if revision.attestation %>; attested by <%= revision.attestation.attester_name %><% end %> · <code><%= revision.sha256.first(12) %></code></dd>
        </div>
      <% end %>
    </dl>
    <% if @minutes.reopened? %><p class="helper">The preserved revision remains available to members while the corrected working record is completed.</p><% end %>
  </section>
<% end %>

<div class="agenda-meeting-snapshot minutes-meeting-snapshot">
  <span>Meeting details</span>
  <strong><%= @minutes.location_name %></strong>
  <% if @minutes.location_address.present? %><span><%= @minutes.location_address.lines.first.strip %></span><% end %>
  <% if editable %><%= link_to "Change minutes heading", edit_admin_meeting_minutes_path(@meeting) %><% end %>
</div>

<section class="minutes-workflow-band" aria-labelledby="minutes-workflow-heading">
  <div class="minutes-workflow-band-head">
    <div>
      <p class="meeting-workflow-kicker">Source and review</p>
      <h2 id="minutes-workflow-heading">Check the working record</h2>
    </div>
    <p>These tools support the record below. Transcript and AI evidence never appear in its PDF.</p>
  </div>

  <div class="minutes-workflow-tools">
    <article class="minutes-workflow-tool">
      <p class="minutes-workflow-tool-label">Transcript</p>
      <% if @meeting.transcript %>
        <strong>Restricted source ready</strong>
        <p><%= number_to_human_size(@meeting.transcript.byte_size) %><% if @meeting.transcript.original_filename.present? %> &middot; <%= @meeting.transcript.original_filename %><% end %></p>
        <%= link_to "Review transcript", admin_meeting_transcript_path(@meeting), class: "minutes-workflow-link" %>
      <% else %>
        <strong>No transcript added</strong>
        <p>The minutes can still be completed manually.</p>
        <% if editable %><%= link_to "Add transcript", new_admin_meeting_transcript_path(@meeting), class: "minutes-workflow-link" %><% end %>
      <% end %>
    </article>

    <article class="minutes-workflow-tool">
      <p class="minutes-workflow-tool-label">AI first pass</p>
      <% if latest_run&.succeeded? && unreviewed_count.positive? %>
        <strong><%= pluralize(unreviewed_count, "suggestion") %> to review</strong>
        <p>Each proposal remains separate until you use, correct, or discard it.</p>
        <% if editable %><%= link_to "Continue AI review", admin_meeting_minutes_draft_run_path(@meeting, latest_run), class: "minutes-workflow-link minutes-workflow-link--primary" %><% end %>
      <% elsif latest_run&.succeeded? %>
        <strong>AI review complete</strong>
        <p>Every suggestion from the latest run has a human decision.</p>
        <%= link_to "View reviewed run", admin_meeting_minutes_draft_run_path(@meeting, latest_run), class: "minutes-workflow-link" %>
      <% elsif latest_run&.pending? || latest_run&.running? %>
        <strong>Drafting in progress</strong>
        <p>You may keep editing while the background job works.</p>
        <%= link_to "Check drafting status", admin_meeting_minutes_draft_run_path(@meeting, latest_run), class: "minutes-workflow-link" %>
      <% elsif latest_run&.failed? %>
        <strong>Latest run needs attention</strong>
        <p>The manual record below is unchanged.</p>
        <%= link_to "Review failed run", admin_meeting_minutes_draft_run_path(@meeting, latest_run), class: "minutes-workflow-link" %>
      <% elsif @meeting.transcript && editable %>
        <strong>Ready for a first pass</strong>
        <p>AI suggestions remain source-linked and require human review.</p>
        <%= link_to "Create first draft", new_admin_meeting_minutes_draft_run_path(@meeting), class: "minutes-workflow-link minutes-workflow-link--primary" %>
      <% else %>
        <strong>No AI run yet</strong>
        <p>Add a transcript to make a source-linked first pass available.</p>
      <% end %>
    </article>

    <article class="minutes-workflow-tool">
      <p class="minutes-workflow-tool-label">Officer roll call</p>
      <% if @minutes.attendance_entries.any? %>
        <% unresolved_attendance = @minutes.attendance_entries.count { |entry| entry.status == "not_recorded" } %>
        <strong><%= unresolved_attendance.positive? ? "#{pluralize(unresolved_attendance, "office")} need review" : "Attendance reviewed" %></strong>
        <p><%= pluralize(@minutes.attendance_entries.size, "office") %> in this meeting's historical roster.</p>
        <% if editable %><%= link_to "Record attendance", edit_admin_meeting_minutes_attendance_path(@meeting), class: "minutes-workflow-link" %><% end %>
      <% else %>
        <strong>No officer roll call</strong>
        <p>No historical officer rows were copied into these minutes.</p>
      <% end %>
    </article>
  </div>
</section>

<main class="minutes-outline minutes-record" aria-labelledby="minutes-outline-heading">
  <div class="minutes-outline-head">
    <div>
      <p class="meeting-workflow-kicker"><%= organizing ? "Organization mode" : "Structured meeting record" %></p>
      <h2 id="minutes-outline-heading"><%= organizing ? "Arrange the meeting order" : "Minutes record" %></h2>
    </div>
    <div class="minutes-outline-summary">
      <p><%= pluralize(@minutes.sections.size, "section") %> &middot; <%= pluralize(@minutes.items.size, "item") %></p>
      <% if organizing %><span>Move controls are now shown.</span><% end %>
    </div>
  </div>

  <% @minutes.sections.each_with_index do |section, section_index| %>
    <section class="minutes-section" aria-labelledby="minutes-section-<%= section.id %>">
      <div class="minutes-section-rail" aria-hidden="true"><span><%= section_index + 1 %></span></div>
      <div class="minutes-section-content">
        <div class="minutes-section-heading">
          <h3 id="minutes-section-<%= section.id %>"><%= section.title %></h3>
          <% if editable %>
            <div class="minutes-order-actions" aria-label="Actions for <%= section.title %>">
              <% if organizing && section_index.positive? %>
                <%= button_to "↑", move_admin_meeting_minutes_section_path(@meeting, section, direction: "up"), method: :patch, class: "minutes-order-button", title: "Move section up", aria: { label: "Move #{section.title} up" } %>
              <% end %>
              <% if organizing && section_index < @minutes.sections.length - 1 %>
                <%= button_to "↓", move_admin_meeting_minutes_section_path(@meeting, section, direction: "down"), method: :patch, class: "minutes-order-button", title: "Move section down", aria: { label: "Move #{section.title} down" } %>
              <% end %>
              <%= link_to "Edit section", edit_admin_meeting_minutes_section_path(@meeting, section), class: "minutes-text-action" %>
            </div>
          <% end %>
        </div>

        <% if section.items.any? %>
          <ol class="minutes-item-list">
            <% section.items.each_with_index do |item, item_index| %>
              <li class="minutes-item-card<%= " minutes-item-card--substantive" if item.body.present? || item.outcomes.any? %>">
                <div class="minutes-item-heading">
                  <div>
                    <span class="minutes-item-title"><%= item.title %></span>
                    <% unless item.source_dated_agenda_item %><span class="minutes-added-label">Added during the meeting</span><% end %>
                  </div>
                  <% if editable %>
                    <div class="minutes-order-actions" aria-label="Actions for <%= item.title %>">
                      <% if organizing && item_index.positive? %>
                        <%= button_to "↑", move_admin_meeting_minutes_item_path(@meeting, item, direction: "up"), method: :patch, class: "minutes-order-button", title: "Move item up", aria: { label: "Move #{item.title} up" } %>
                      <% end %>
                      <% if organizing && item_index < section.items.length - 1 %>
                        <%= button_to "↓", move_admin_meeting_minutes_item_path(@meeting, item, direction: "down"), method: :patch, class: "minutes-order-button", title: "Move item down", aria: { label: "Move #{item.title} down" } %>
                      <% end %>
                      <%= link_to "Edit", edit_admin_meeting_minutes_item_path(@meeting, item), class: "minutes-text-action" %>
                    </div>
                  <% end %>
                </div>
                <% if item.agenda_body.present? %><div class="minutes-agenda-wording"><%= item.agenda_body %></div><% end %>
                <% if item.body.present? %>
                  <div class="minutes-recorded-wording">
                    <p class="minutes-recorded-wording-label">Recorded minutes</p>
                    <div><%= item.body %></div>
                  </div>
                <% end %>
                <% if item.endeavor %><p class="minutes-endeavor-link">Related Endeavor: <%= link_to item.endeavor.title, endeavor_path(item.endeavor) %></p><% end %>

                <% if item.outcomes.any? %>
                  <ol class="minutes-outcome-list">
                    <% item.outcomes.each_with_index do |outcome, outcome_index| %>
                      <li>
                        <div class="minutes-outcome-heading">
                          <strong><%= outcome.kind.humanize %></strong>
                          <span class="minutes-outcome-disposition minutes-outcome-disposition--<%= outcome.disposition %>"><%= minutes_outcome_disposition_label(outcome.disposition) %></span>
                        </div>
                        <p><%= outcome.text %></p>
                        <% details = [("Moved by #{outcome.mover_name}" if outcome.mover_name), ("Seconded by #{outcome.seconder_name}" if outcome.seconder_name), outcome.vote_summary].compact %>
                        <% if details.any? %><p class="minutes-outcome-details"><%= details.join(" · ") %></p><% end %>
                        <% if editable %>
                          <div class="minutes-outcome-actions">
                            <% if organizing && outcome_index.positive? %><%= button_to "↑", move_admin_meeting_minutes_outcome_path(@meeting, outcome, direction: "up"), method: :patch, class: "minutes-order-button", aria: { label: "Move outcome up" } %><% end %>
                            <% if organizing && outcome_index < item.outcomes.length - 1 %><%= button_to "↓", move_admin_meeting_minutes_outcome_path(@meeting, outcome, direction: "down"), method: :patch, class: "minutes-order-button", aria: { label: "Move outcome down" } %><% end %>
                            <%= link_to "Edit outcome", edit_admin_meeting_minutes_outcome_path(@meeting, outcome), class: "minutes-text-action" %>
                          </div>
                        <% end %>
                      </li>
                    <% end %>
                  </ol>
                <% end %>
                <% if editable %><%= link_to "+ Record motion or decision", new_admin_meeting_minutes_outcome_path(@meeting, minutes_item_id: item.id), class: "minutes-add-outcome" %><% end %>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="minutes-empty-note">No items recorded in this section yet.</p>
        <% end %>
        <% if editable %><%= link_to "+ Add item to #{section.title}", new_admin_meeting_minutes_item_path(@meeting, minutes_section_id: section.id), class: "minutes-add-item" %><% end %>
      </div>
    </section>
  <% end %>

  <% if editable %>
    <div class="minutes-outline-footer">
      <%= link_to "+ Add section", new_admin_meeting_minutes_section_path(@meeting), class: "btn-secondary" %>
    </div>
  <% end %>
</main>
