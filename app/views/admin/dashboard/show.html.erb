<% groups = admin_workspace_groups %>
<% columns = groups.group_by { |group| group[:column] } %>
<% content_for :title, admin_area_name %>

<div class="admin-workspace">
  <div class="page-lead">
    <h1 class="page-title"><%= admin_area_name %></h1>
    <p class="page-sub">Manage accounts, configuration, and application maintenance.</p>
  </div>

  <% if @roster_stale %>
    <section class="workspace-attention" aria-labelledby="workspace-attention-heading">
      <%= render "shared/section_header", label: "Needs attention", heading_tag: :h2, heading_id: "workspace-attention-heading" %>
      <div class="workspace-attention-content">
        <div>
          <h3><%= @latest_roster_import ? "Roster import is due" : "Import your first roster" %></h3>
          <p>
            <% if @latest_roster_import %>
              Last imported <%= legion_date(@latest_roster_import.imported_at) %>. Bring your membership information up to date.
            <% else %>
              Upload the National roster to bring your Post's membership information into the tools.
            <% end %>
          </p>
        </div>
        <%= link_to "Import roster", new_admin_roster_import_path, class: "btn-primary" %>
      </div>
    </section>
  <% end %>

  <div class="workspace-groups<%= " workspace-groups--single" if columns.one? %>">
    <% columns.each_value do |column_groups| %>
      <div class="workspace-column">
        <% column_groups.each do |group| %>
          <section class="workspace-group workspace-group--<%= group[:key] %>" aria-labelledby="workspace-<%= group[:key] %>">
            <%= render "shared/section_header", label: group[:label], heading_tag: :h2, heading_id: "workspace-#{group[:key]}" %>
            <div class="mrow-list">
              <% group[:destinations].each do |destination| %>
                <%= link_to destination[:path], class: "mrow workspace-destination" do %>
                  <span class="mrow-id">
                    <span class="mrow-name"><%= destination[:label] %></span>
                    <% if destination[:roster] %>
                      <span class="workspace-roster-status <%= @roster_stale ? "workspace-roster-status--due" : "workspace-roster-status--current" %>">
                        <%= admin_workspace_roster_status %>
                      </span>
                    <% end %>
                    <span class="mrow-sub"><%= destination[:description] %></span>
                  </span>
                  <span class="workspace-destination-arrow" aria-hidden="true">›</span>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>

</div>
