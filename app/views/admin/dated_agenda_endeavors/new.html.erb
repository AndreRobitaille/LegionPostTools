<% content_for :title, "Add Endeavor to #{@dated_agenda.title}" %>
<%= link_to "← #{@dated_agenda.title}", edit_admin_dated_agenda_path(@dated_agenda), class: "back" %>

<div class="page-lead">
  <h1 class="page-title">Add Endeavor</h1>
  <p class="page-sub">Bring continuing Post work forward into this meeting as an independent snapshot.</p>
</div>

<div class="picker-destination">
  <span>Adding to</span><strong><%= @agenda_section.title %></strong>
</div>

<div class="endeavor-docket">
  <% if @priority_groups.values.flatten(1).any? %>
    <% @priority_groups.each do |bucket, entries| %>
      <% next if entries.empty? %>
      <section class="endeavor-bucket endeavor-bucket--<%= bucket %>">
        <%= render "shared/section_header", label: Endeavor::PRIORITY_BUCKETS.fetch(bucket), meta: pluralize(entries.size, "item") %>
        <div class="mrow-list">
          <% entries.each do |endeavor, already_added| %>
            <% row_classes = [ "mrow" ]
               row_classes << "mrow--important" if endeavor.important?
               row_classes << "mrow--done" if already_added
               due_label = endeavor_due_label(endeavor) %>
            <div class="<%= row_classes.join(" ") %>">
              <span class="mrow-id">
                <span class="mrow-l1"><span class="mrow-name"><%= endeavor.title %></span></span>
                <% if endeavor.summary.present? %>
                  <span class="mrow-sub"><%= endeavor.summary %></span>
                <% end %>
                <span class="endeavor-why"><%= endeavor_reason(endeavor) %></span>
              </span>
              <span class="mrow-status">
                <% if due_label %>
                  <span class="mrow-kv"><span class="k"><%= due_label %></span> <%= legion_date(endeavor.raise_by_on) %></span>
                <% end %>
              </span>
              <span class="catrow-meta">
                <% if already_added %>
                  <span class="catrow-flag">Already added</span>
                <% else %>
                  <%= button_to "Add to this meeting", admin_dated_agenda_endeavors_path(@dated_agenda, endeavor_id: endeavor.id, dated_agenda_section_id: @agenda_section.id), method: :post, class: "btn-secondary btn-sm" %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="empty">
      <span class="empty-mark" aria-hidden="true">&#9670;</span>
      <div>
        <h2>Nothing is being tracked</h2>
        <p>Create an Endeavor for coherent Post work that should continue across meetings.</p>
        <div class="btnrow"><%= link_to "New Endeavor", new_endeavor_path, class: "btn-secondary" %></div>
      </div>
    </div>
  <% end %>
</div>
