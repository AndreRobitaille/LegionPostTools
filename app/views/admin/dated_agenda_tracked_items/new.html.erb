<% content_for :title, "Add tracked business to #{@dated_agenda.title}" %>
<%= link_to "← #{@dated_agenda.title}", edit_admin_dated_agenda_path(@dated_agenda), class: "back" %>

<div class="page-lead">
  <h1 class="page-title">Add tracked business</h1>
  <p class="page-sub">Bring unfinished post business forward into this meeting.</p>
</div>

<div class="picker-destination">
  <span>Adding to</span><strong><%= @agenda_section.title %></strong>
</div>

<div class="tracked-docket">
  <% if @priority_groups.values.flatten(1).any? %>
    <% @priority_groups.each do |bucket, entries| %>
      <% next if entries.empty? %>
      <section class="tracked-bucket tracked-bucket--<%= bucket %>">
        <%= render "shared/section_header", label: TrackedItem::PRIORITY_BUCKETS.fetch(bucket), meta: pluralize(entries.size, "item") %>
        <div class="mrow-list">
          <% entries.each do |tracked_item, already_added| %>
            <% row_classes = [ "mrow" ]
               row_classes << "mrow--important" if tracked_item.important?
               row_classes << "mrow--done" if already_added
               due_label = tracked_item_due_label(tracked_item) %>
            <div class="<%= row_classes.join(" ") %>">
              <span class="mrow-id">
                <span class="mrow-l1"><span class="mrow-name"><%= tracked_item.title %></span></span>
                <% if tracked_item.summary.present? %>
                  <span class="mrow-sub"><%= tracked_item.summary %></span>
                <% end %>
                <span class="tracked-why"><%= tracked_item_reason(tracked_item) %></span>
              </span>
              <span class="mrow-status">
                <% if due_label %>
                  <span class="mrow-kv"><span class="k"><%= due_label %></span> <%= legion_date(tracked_item.raise_by_on) %></span>
                <% end %>
              </span>
              <span class="catrow-meta">
                <% if already_added %>
                  <span class="catrow-flag">Already added</span>
                <% else %>
                  <%= button_to "Add to this meeting", admin_dated_agenda_tracked_items_path(@dated_agenda, tracked_item_id: tracked_item.id, dated_agenda_section_id: @agenda_section.id), method: :post, class: "btn-secondary btn-sm" %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="empty">
      <span class="empty-mark" aria-hidden="true">&#9670;</span>
      <div>
        <h2>Nothing is being tracked</h2>
        <p>Start tracking a piece of business before bringing it into an agenda.</p>
        <div class="btnrow"><%= link_to "Track new business", new_tracked_item_path, class: "btn-secondary" %></div>
      </div>
    </div>
  <% end %>
</div>
