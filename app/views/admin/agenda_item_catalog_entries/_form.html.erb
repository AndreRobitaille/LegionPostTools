<%= form_with model: [:admin, entry], class: "stacked-form" do |form| %>
  <% if entry.seeded? %>
    <p class="page-sub">This changes your post's local copy only. It will not affect the original seed.</p>
  <% end %>
  <% if entry.errors.any? %>
    <div class="error-summary">
      <h2><%= pluralize(entry.errors.count, "error") %> prohibited this agenda item catalog entry from being saved:</h2>
      <ul>
        <% entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="fl">
    <%= form.label :title %>
    <%= form.text_field :title, class: "f" %>
  </div>
  <div class="fl">
    <%= form.label :summary, "Summary or guidance" %>
    <%= form.text_area :summary, class: "f", rows: 3 %>
  </div>
  <div class="fl">
    <%= form.label :category, "Usually used under" %>
    <p class="fl-help">This helps officers find the item. It can still be placed in any agenda section.</p>
    <%= form.select :category, AgendaItemCatalogEntry::CATEGORIES.map { |value, label| [label, value] }, {}, class: "f" %>
  </div>
  <div class="fl">
    <%= form.label :behavior_type, "Item kind" %>
    <p class="fl-help">The kind of item this is. Sections are managed separately in meeting templates and dated agendas.</p>
    <%= form.select :behavior_type, AgendaItemCatalogEntry.behavior_types_for_form(entry.behavior_type).map { |value, label| [label, value] }, {}, class: "f" %>
  </div>
  <%= render "admin/shared/agenda_item_document_fields", form: form %>
  <label class="form-toggle">
    <%= form.check_box :active %>
    <span>
      <span class="ft-label">Active</span>
      <span class="ft-help">Inactive items stay in the catalog but are hidden when building agendas.</span>
    </span>
  </label>
  <div class="btnrow">
    <%= form.submit "Save changes", class: "btn-primary" %>
    <%= link_to "Cancel", admin_agenda_item_catalog_entries_path, class: "btn-secondary" %>
  </div>
<% end %>
