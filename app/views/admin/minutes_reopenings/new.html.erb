<% content_for :title, "Reopen minutes for correction" %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead">
  <h1 class="page-title">Reopen minutes for correction</h1>
  <p class="page-sub"><%= @minutes.title %> · <%= legion_date(@minutes.starts_at) %> · Revision <%= @minutes.current_revision.number %></p>
</div>

<% if (pending = pending_minutes_signature(@minutes, "reopen")) %>
  <%= render "official_action_reauthentications/email", confirmation: pending %>
<% else %>
  <%= form_with url: admin_meeting_minutes_reopening_path(@meeting), scope: :minutes_reopening, class: "stacked-form official-action-form", id: "minutes-signing", data: { turbo: false, controller: "minutes-signing" } do |form| %>
    <div class="fl">
      <%= form.label :reason, "Why are these minutes being reopened?" %>
      <%= form.text_area :reason, rows: 3, class: "f", required: true %>
      <span class="fl-help">Your reason stays in the record. Enter the corrected wording after reopening.</span>
    </div>
    <%= render "official_action_reauthentications/methods", minutes: @minutes, action: "reopen", cancel_path: admin_meeting_minutes_path(@meeting) %>
  <% end %>
<% end %>
