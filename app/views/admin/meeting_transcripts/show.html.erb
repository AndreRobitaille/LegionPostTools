<% content_for :title, "Restricted transcript — #{@meeting.title}" %>
<%= link_to(@meeting.minutes ? admin_meeting_minutes_path(@meeting) : admin_meeting_path(@meeting), class: "back") do %>&larr; <%= @meeting.minutes ? "Minutes workspace" : "Meeting record" %><% end %>

<div class="page-lead-row transcript-page-lead">
  <div class="page-lead">
    <p class="minutes-eyebrow">Restricted source &middot; not part of the published record</p>
    <h1 class="page-title">Meeting transcript</h1>
    <p class="page-sub"><%= @meeting.title %> &middot; <%= legion_datetime(@meeting.starts_at) %></p>
  </div>
  <span class="minutes-draft-stamp minutes-draft-stamp--restricted">Restricted</span>
</div>

<dl class="transcript-facts">
  <div><dt>Source</dt><dd><%= @transcript.pasted_text? ? "Pasted text" : @transcript.original_filename %></dd></div>
  <div><dt>Size</dt><dd><%= number_to_human_size(@transcript.byte_size) %></dd></div>
  <div><dt>Retention</dt><dd><%= @transcript.retention_policy == "delete_after_acceptance" ? "Delete 30 days after the minutes become final" : "Retain as restricted source" %></dd></div>
  <div><dt>Added</dt><dd><%= legion_datetime(@transcript.created_at) %></dd></div>
  <% if (scheduled_at = @transcript.scheduled_purge_at) %>
    <div><dt>Scheduled removal</dt><dd><%= legion_datetime(scheduled_at.in_time_zone(@meeting.organization.calendar_time_zone)) %> (Post time)</dd></div>
  <% elsif @transcript.retention_policy == "delete_after_acceptance" %>
    <div><dt>Recovery window</dt><dd>Starts when the minutes become final, after any pending corrections are attested.</dd></div>
  <% end %>
  <% if @transcript.purged_at.present? %>
    <div><dt>Removed</dt><dd><%= legion_datetime(@transcript.purged_at.in_time_zone(@meeting.organization.calendar_time_zone)) %> (Post time)<%= " by automatic retention" if @transcript.purged_by_service.present? %></dd></div>
  <% end %>
</dl>

<section class="transcript-reader" aria-labelledby="transcript-content-heading">
  <div class="transcript-reader-head">
    <h2 id="transcript-content-heading">Source text</h2>
    <span>Read only</span>
  </div>
  <% if @transcript.source_available? %>
    <pre><%= @transcript.source_text %></pre>
  <% elsif @transcript.purged_at.present? %>
    <p class="minutes-empty-note">The transcript content has been purged. Its non-content audit metadata remains.</p>
  <% elsif @transcript.purge_started_at.present? %>
    <p class="minutes-empty-note">Removal is pending. The source is unavailable while this app retries removal. Its non-content audit metadata remains.</p>
  <% else %>
    <p class="minutes-empty-note">The source is unavailable. Its non-content audit metadata remains.</p>
  <% end %>
</section>
