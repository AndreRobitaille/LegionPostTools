<% content_for :title, "Record meeting approval" %>
<%= link_to admin_meeting_minutes_path(@meeting), class: "back" do %>&larr; Minutes workspace<% end %>

<div class="page-lead">
  <h1 class="page-title">Record the meeting's approval</h1>
  <p class="page-sub"><%= @minutes.title %> · <%= legion_date(@minutes.starts_at) %></p>
</div>

<% if (pending = pending_minutes_signature(@minutes, "record_membership_approval")) %>
  <%= render "official_action_reauthentications/email", confirmation: pending %>
<% else %>
  <%= form_with url: admin_meeting_minutes_membership_approval_path(@meeting), scope: :minutes_membership_approval, class: "stacked-form official-action-form", id: "minutes-signing", data: { turbo: false, controller: "minutes-signing", action: "change->minutes-signing#describeDecision" } do |form| %>
    <p class="panel-lead">Record the decision made at the later meeting. <%= @minutes.current_revision.attestation.attester_name %> attested this copy on <%= legion_date(@minutes.current_revision.attestation.attested_at) %>.</p>
    <% values = params.fetch(:minutes_membership_approval, {}) %>
    <div class="fl">
      <%= form.label :approving_meeting_id, "Meeting where these minutes were approved" %>
      <%= form.collection_select :approving_meeting_id, @eligible_meetings, :id, ->(meeting) { "#{meeting.meeting_body.name} — #{legion_date(meeting.starts_at)}" }, { prompt: "Choose a meeting", selected: values[:approving_meeting_id] }, { class: "f", required: true } %>
    </div>

    <fieldset class="transcript-retention minutes-approval-choices">
      <legend>What did the meeting approve?</legend>
      <label class="transcript-choice">
        <%= form.radio_button :disposition, "approved_as_presented", checked: values[:disposition] == "approved_as_presented", required: true %>
        <span><strong>Approved as presented</strong><small>The attested text required no correction.</small></span>
      </label>
      <label class="transcript-choice">
        <%= form.radio_button :disposition, "approved_as_corrected", checked: values[:disposition] == "approved_as_corrected", required: true %>
        <span><strong>Approved with corrections</strong><small>Record the adopted corrections below. Enter them in the draft, then the Adjutant confirms and locks the final copy.</small></span>
      </label>
      <label class="transcript-choice">
        <%= form.radio_button :disposition, "approved_by_motion", checked: values[:disposition] == "approved_by_motion", required: true %>
        <span><strong>Approved by recorded motion</strong><small>Use only when a motion was actually the procedure.</small></span>
      </label>
      <label class="transcript-choice">
        <%= form.radio_button :disposition, "other", checked: values[:disposition] == "other", required: true %>
        <span><strong>Another recorded procedure</strong><small>Describe exactly what occurred below.</small></span>
      </label>
    </fieldset>

    <label class="transcript-choice">
      <%= form.check_box :corrections_pending, { checked: values[:corrections_pending] == "0" }, "0", "1" %>
      <span><strong>The corrections are already in this attested copy</strong><small>For approval with corrections only: checking this locks the current copy immediately.</small></span>
    </label>

    <div class="fl">
      <%= form.label :factual_note, "Corrections or procedure note" %>
      <%= form.text_area :factual_note, value: values[:factual_note], rows: 3, class: "f" %>
      <p class="helper">List the corrections adopted, or describe another approval procedure. Leave blank for approval as presented.</p>
    </div>
    <%= render "official_action_reauthentications/methods", minutes: @minutes, action: "record_membership_approval", cancel_path: admin_meeting_minutes_path(@meeting) %>
  <% end %>
<% end %>
