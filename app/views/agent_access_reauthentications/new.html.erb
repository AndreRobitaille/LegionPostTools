<% content_for :title, "Confirm your identity" %>

<div class="page-lead">
  <h1 class="page-title">Confirm your identity</h1>
  <p class="page-sub">Creating a new agent token requires a recent sign-in.</p>
</div>

<section class="profile-section">
  <%= render "shared/section_header", label: "Choose how to confirm" %>
  <div class="panel">
    <% if cookies.encrypted[AgentAccessReauthenticationsController::PENDING_COOKIE].present? %>
      <div class="agent-reauth-code">
        <h2>Enter the emailed code</h2>
        <p class="panel-lead">Find the code in your email and enter it in this browser. It works once and expires after 15 minutes.</p>
        <%= form_with url: verify_agent_access_reauthentication_path, method: :post, class: "stacked-form" do |form| %>
          <div class="fl">
            <%= form.label :code, "8-digit confirmation code" %>
            <%= form.text_field :code, class: "f agent-code-input", inputmode: "numeric",
                  autocomplete: "one-time-code", placeholder: "1234 5678", maxlength: 9,
                  required: true, autofocus: true %>
          </div>
          <%= form.button "Confirm identity", class: "btn-primary" %>
        <% end %>
        <%= button_to "Send a new code", agent_access_reauthentication_path,
              method: :post, class: "lnk agent-reauth-resend" %>
      </div>
    <% else %>
      <p class="panel-lead">Send a one-time code to <strong><%= current_user.email_address %></strong>. Keep this page open while you check your email.</p>
      <%= button_to "Email me a confirmation code", agent_access_reauthentication_path,
            method: :post, class: "btn-primary" %>
    <% end %>

    <% if current_user.passkey_credentials.any? %>
      <div class="agent-reauth-passkey" data-controller="passkey" data-passkey-redirect-value="<%= new_agent_access_token_path %>">
        <div class="entry-orline">Or use a passkey</div>
        <button type="button" class="btn-secondary" data-action="passkey#authenticate" data-passkey-target="submit">
          Confirm with a passkey
        </button>
        <p class="pk-card-status" data-passkey-target="status" role="status" aria-live="polite"></p>
      </div>
    <% end %>
  </div>
</section>

<p class="profile-crosslink"><%= link_to "Back to agent access", agent_access_tokens_path, class: "lnk" %></p>
