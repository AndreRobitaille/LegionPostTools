<div class="agenda-outline">
  <% commander_copy = local_assigns.fetch(:commander_copy, false) %>
  <% dated_agenda.dated_agenda_sections.ordered.each_with_index do |agenda_section, section_index| %>
    <% items = agenda_section.agenda_items.select(&:active?) %>

    <section class="agenda-chapter">
      <div class="agenda-chapter-rail" aria-hidden="true">
        <span class="agenda-chapter-number"><%= section_index + 1 %></span>
      </div>

      <div class="agenda-chapter-content">
        <header class="agenda-chapter-head">
          <h2><%= agenda_section.title %></h2>
          <span class="agenda-chapter-rule" aria-hidden="true"></span>
        </header>

        <div class="agenda-chapter-items">
          <% if items.empty? %>
            <p class="agenda-chapter-empty">No items listed in advance.</p>
          <% end %>
          <% items.each do |agenda_item| %>
            <%# The summary is guidance for whoever builds the agenda; the body is
                what the meeting actually needs. Showing both makes the printed
                agenda say everything twice, so the summary only stands in when
                an item has no body of its own. %>
            <section class="agenda-item">
              <h3 class="agenda-item-title"><%= agenda_item.title %></h3>
              <% if agenda_item.body.present? && agenda_item.show_wording_on_agenda? %>
                <div class="agenda-item-body"><%= agenda_item.body %></div>
              <% elsif agenda_item.body.blank? && agenda_item.summary.present? %>
                <p class="agenda-item-summary"><%= agenda_item.summary %></p>
              <% end %>
              <% if commander_copy && agenda_item.commander_notes.present? %>
                <aside class="commander-cue">
                  <p class="commander-cue-label">Commander's cue</p>
                  <div class="commander-cue-body"><%= agenda_item.commander_notes %></div>
                </aside>
              <% end %>
              <% if commander_copy && agenda_item.roll_call? %>
                <%= render "dated_agendas/roll_call", entries: agenda_item.roll_call_entries %>
              <% end %>
            </section>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>
</div>
