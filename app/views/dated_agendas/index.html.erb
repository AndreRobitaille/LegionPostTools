<% content_for :title, "Meetings" %>

<div class="page-lead">
  <h1 class="page-title">Meetings</h1>
  <p class="page-sub">Published agendas for upcoming post meetings.</p>
</div>

<% if @dated_agendas.any? %>
  <div class="agenda-docket">
    <% @dated_agendas.each_with_index do |dated_agenda, index| %>
      <% day, month, year = legion_date_parts(dated_agenda.starts_at) %>
      <%= link_to dated_agenda_path(dated_agenda), class: "agenda-docket-row", aria: { label: "Read the agenda for #{dated_agenda.title}" } do %>
        <time class="agenda-docket-date" datetime="<%= dated_agenda.starts_at.to_date.iso8601 %>">
          <span class="agenda-docket-day"><%= day %></span>
          <span class="agenda-docket-month"><%= month %></span>
          <span class="agenda-docket-year"><%= year %></span>
        </time>
        <span class="agenda-docket-copy">
          <% if index.zero? %><span class="agenda-docket-next">Next meeting</span><% end %>
          <span class="agenda-docket-title"><%= dated_agenda.title %></span>
          <span class="agenda-docket-meta"><%= dated_agenda.meeting_body.name %> &middot; <%= legion_time(dated_agenda.starts_at) %></span>
        </span>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="empty">
    <span class="empty-mark" aria-hidden="true">&#9670;</span>
    <div>
      <h2>No upcoming agendas</h2>
      <p>Published agendas appear here as soon as the next meeting is ready. Nothing to read yet.</p>
    </div>
  </div>
<% end %>
