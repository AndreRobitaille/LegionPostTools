<article class="agenda-doc">
  <header class="agenda-masthead">
    <p class="agenda-org-name"><%= organization.name %></p>
    <p class="agenda-document-label"><span aria-hidden="true">◆</span> Published agenda <span aria-hidden="true">◆</span></p>
    <h1><%= dated_agenda.title %></h1>
    <p class="agenda-meeting-meta">
      <span><%= dated_agenda.meeting_body.name %></span>
      <span class="agenda-meta-diamond" aria-hidden="true">◆</span>
      <time datetime="<%= dated_agenda.starts_at.iso8601 %>"><%= legion_datetime(dated_agenda.starts_at) %></time>
    </p>
    <div class="agenda-masthead-rule" aria-hidden="true"><span>◆</span></div>
  </header>

  <%= render "agenda_body",
    dated_agenda: dated_agenda,
    show_summaries: local_assigns.fetch(:show_summaries, true) %>
</article>
