<% content_for :title, @dated_agenda.title %>

<nav class="agenda-page-actions" aria-label="Agenda actions">
  <%= link_to meeting_path(@dated_agenda.meeting), class: "agenda-back-link" do %><span aria-hidden="true">&larr;</span> Meeting record<% end %>
  <%= link_to "Open agenda PDF", print_dated_agenda_path(@dated_agenda), class: "btn-secondary agenda-print-link", data: { turbo: false } %>
</nav>

<%= render "agenda_document", dated_agenda: @dated_agenda, organization: @organization %>
