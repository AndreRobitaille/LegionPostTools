<header class="calendar-print-heading">
  <div>
    <p class="calendar-print-post"><%= @organization.name %></p>
    <h2 class="calendar-print-month"><time datetime="<%= date.strftime('%Y-%m') %>"><%= date.strftime("%B %Y") %></time></h2>
  </div>
  <p class="calendar-print-section"><%= section %></p>
</header>
