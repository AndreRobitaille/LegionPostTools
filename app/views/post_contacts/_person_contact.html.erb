<% person = assignment.person %>
<% office = assignment.position_title.name %>
<% email = person.directory_email_address %>
<% phone = person.directory_phone_number %>
<% phone_href = post_contact_phone_href(phone) %>
<div class="post-contact-person">
  <div class="post-contact-identity">
    <%= link_to person.roster_display_name, person_path(person), class: "post-contact-name" %>
    <% if phone.present? || email.present? %>
      <div class="post-contact-details">
        <% if phone.present? %><p><%= phone %></p><% end %>
        <% if email.present? %><p><%= email %></p><% end %>
      </div>
    <% else %>
      <p class="post-contact-note">No direct contact details listed.</p>
    <% end %>
  </div>
  <% if phone_href.present? || email.present? %>
    <div class="post-contact-actions">
      <% if phone_href.present? %>
        <%= link_to "Call", phone_href, class: "btn-secondary", aria: { label: "Call #{person.roster_display_name}, #{office}" } %>
      <% end %>
      <% if email.present? %>
        <%= mail_to email, "Email", class: "btn-secondary", aria: { label: "Email #{person.roster_display_name}, #{office}" } %>
      <% end %>
    </div>
  <% elsif @organization.public_email.present? %>
    <%= mail_to @organization.public_email, "Email the Post for the #{office}", subject: "For the #{office}", class: "post-contact-fallback" %>
  <% end %>
</div>
