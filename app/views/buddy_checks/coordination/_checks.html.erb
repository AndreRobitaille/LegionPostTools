<% contacts.each do |contact| %>
  <article class="membership-contact buddy-post-check">
    <h2><% if show_member %><%= link_to contact.person.full_name, buddy_checks_member_history_path(contact.person) %> · <% end %><%= MembershipContact::OUTCOMES.fetch(contact.outcome) %></h2>
    <p><%= contact.occurred_at ? buddy_time(contact.occurred_at) : legion_date(contact.occurred_on) %> · <%= MembershipContact::CHANNELS.fetch(contact.channel) %></p>
    <p class="membership-secondary">Recorded by <%= contact.recorded_by.person.full_name %> · Revision <%= contact.revision %></p>
    <% if contact.notes.present? %><p class="membership-notes"><%= contact.notes %></p><% end %>
    <% if contact.follow_up_on %><p>Recorded callback date: <%= legion_date(contact.follow_up_on) %></p><% end %>
  </article>
<% end %>
