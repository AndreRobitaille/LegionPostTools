<% minutes = @confirmation.meeting_minutes %>
<% labels = minutes_signing_labels(@confirmation.action, minutes) %>
<% content_for :title, labels.fetch(:heading) %>
<div class="page-lead">
  <h1 class="page-title"><%= labels.fetch(:heading) %></h1>
  <p class="page-sub"><%= minutes.title %> · <%= legion_date(minutes.starts_at) %></p>
</div>
<section class="panel minutes-signing">
  <%= render "summary", confirmation: @confirmation %>
  <% if @confirmation.action == "attest" %>
    <%= render "minutes_distributions/meeting_status", minutes:, manage: false %>
  <% end %>
  <div class="btnrow">
    <%= button_to labels.fetch(:email), magic_link_official_action_reauthentication_path, params: { confirmation_id: @confirmation.id, token: params[:token] }, class: "btn-confirm" %>
    <%= button_to "Cancel", official_action_reauthentication_path(confirmation_id: @confirmation.id), method: :delete, class: "btn-secondary" %>
  </div>
</section>
