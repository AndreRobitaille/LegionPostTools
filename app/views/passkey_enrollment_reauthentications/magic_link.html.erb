<% content_for :title, "Add a passkey" %>
<section class="enrollment-card" aria-labelledby="enrollment-heading" data-turbo="false">
  <%= render "passkey_enrollment_reauthentications/heading", heading_tag: :h1, icon: "mail" do %>
    <p>Confirm it’s you to return to device setup.</p>
  <% end %>
  <div class="enrollment-body">
    <div class="enrollment-actions">
      <div class="enrollment-methods">
        <%= button_to "Continue setup", magic_link_passkey_enrollment_reauthentication_path, params: { token: params[:token] }, class: "btn-primary", autofocus: true %>
      </div>
      <%= button_to "Cancel", passkey_enrollment_reauthentication_path, method: :delete, class: "enrollment-quiet" %>
    </div>
  </div>
</section>
