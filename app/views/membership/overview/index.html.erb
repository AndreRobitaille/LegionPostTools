<% content_for :title, "Membership" %>
<% groups = membership_workspace_groups %>
<div class="task-workspace">
  <div class="page-lead"><h1 class="page-title">Membership</h1><p class="page-sub"><%= @access.manager? ? "Choose the membership work you need to do for your Post." : "Make your assigned calls and keep the next step clear." %></p></div>
  <%= render "membership/year_picker", url: membership_root_path %>
  <div class="workspace-groups<%= " workspace-groups--single" if groups.one? %>">
    <% groups.each do |group| %>
      <section class="workspace-group workspace-group--<%= group[:key] %>" aria-labelledby="membership-<%= group[:key] %>">
        <%= render "shared/section_header", label: group[:label], heading_tag: :h2, heading_id: "membership-#{group[:key]}" %>
        <div class="mrow-list"><% group[:destinations].each do |destination| %><%= render "shared/workspace_destination", **destination %><% end %></div>
      </section>
    <% end %>
  </div>
</div>
