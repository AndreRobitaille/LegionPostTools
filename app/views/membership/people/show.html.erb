<% content_for :title, "#{@person.roster_display_name} · #{@buddy_task ? 'Buddy Check' : 'Membership'}" %>
<% no_outreach = @workspace.outreach_exclusion(@person).present? %>
<div class="task-workspace">
  <%= link_to(@buddy_task ? "Buddy Check drives" : "Membership worklist", @buddy_task ? membership_drives_path(purpose: "buddy_check") : membership_follow_up_path(membership_year: @membership_year), class: "back") %>
  <div class="page-lead"><h1 class="page-title"><%= @person.roster_display_name %></h1><p class="page-sub"><%= @buddy_task ? "Buddy Check caller work" : "Membership year #{@membership_year}" %></p></div>
  <div class="workspace-groups">
    <div class="workspace-column">
      <%= render "shared/section_panel", label: @buddy_task ? "Buddy Check and next step" : "Membership and next step" do %>
        <%= render "membership/member_work", person: @person, work_item: @contact_work_item %>
        <p class="membership-secondary">National roster imported <%= @person.roster_imported_at ? legion_date(membership_local_time(@person.roster_imported_at)) : "date not recorded" %>.</p>
        <% if @workspace.contact_paused?(@person, purpose: @contact.purpose) %><p class="membership-notice">Contact is paused for this purpose. Membership leadership must record renewed permission before further contact.</p><% end %>
        <div class="mrow-list"><%= render "shared/workspace_destination", label: no_outreach ? "Add a review or returned paper result" : "Record contact or review", description: "Record the actual result, brief notes, and any agreed callback.", path: new_membership_person_contact_path(@person, membership_year: @membership_year, assignment_id: @contact.membership_assignment_id) %></div>
      <% end %>
      <%= render "shared/section_panel", label: "Contact information" do %>
        <% unless no_outreach || @workspace.contact_paused?(@person, purpose: @contact.purpose) %>
          <dl class="task-facts"><div><dt>Phone</dt><dd><%= @person.directory_phone_number.present? ? link_to(@person.directory_phone_number, "tel:#{@person.directory_phone_number.gsub(/[^+\d]/, '')}") : "Not recorded" %></dd></div><div><dt>Email</dt><dd><%= @person.directory_email_address.present? ? mail_to(@person.directory_email_address) : "Not recorded" %></dd></div></dl>
          <p class="membership-secondary">Opening a phone or email app does not record a completed contact.</p>
        <% end %>
        <% if @access.manager? %>
          <div class="mrow-list">
            <%= render "shared/workspace_destination", label: "Open full roster record", description: "Review the imported member record and current Post roles.", path: person_path(@person) %>
            <% if current_user.mobile_buddy_checks_access? %><%= render "shared/workspace_destination", label: "Review mailing address", description: "Check address components against a known source.", path: membership_buddy_address_path(@person) %><% end %>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="workspace-column">
<%= render "shared/section_panel", label: @access.manager? ? "Contact history" : "Your contact history" do %>
  <% if @contacts.empty? %><p>No contacts recorded in this selection.</p><% end %>
  <% @contacts.each do |contact| %>
    <article class="membership-contact">
      <h2><%= MembershipContact::OUTCOMES.fetch(contact.outcome) %></h2>
      <p><%= contact.occurred_at ? legion_datetime(membership_local_time(contact.occurred_at)) : legion_date(contact.occurred_on) %> · <%= MembershipContact::CHANNELS.fetch(contact.channel) %> · <%= MembershipDrive::PURPOSES.fetch(contact.purpose) %></p>
      <% if contact.notes.present? %><p class="membership-notes"><%= contact.notes %></p><% end %>
      <% if contact.follow_up_on %><p>Follow-up: <strong><%= legion_date(contact.follow_up_on) %></strong></p><% end %>
      <p class="membership-secondary"><% if contact.membership_assignment %>Caller: <%= contact.membership_assignment.assigned_to.person.full_name %>. <% end %>Recorded by <%= contact.recorded_by.person.full_name %> on <%= legion_date(membership_local_time(contact.created_at)) %>.<% if contact.paper_reference %> Paper reference: <%= contact.paper_reference %>.<% end %></p>
    </article>
  <% end %>
<% end %>


      <% if @access.manager? && !@buddy_task %>
        <%= render "shared/section_panel", label: "Dues and reported payments" do %>
          <details class="membership-correction" <%= "open" if @dues_record.errors.any? %>><summary>Record a payment or National payment report</summary>
            <p class="panel-lead">Local receipts and member reports remain separate from National roster confirmation.</p>
            <%= render "membership/dues_form", person: @person %>
          </details>
          <%= render "membership/dues_records", records: @dues_records %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
