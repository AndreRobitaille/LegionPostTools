<% content_for :title, "Review general-member attendance" %>
<%= link_to "Back to attendance", membership_buddy_attendances_path, class: "back" %>
<div class="page-lead"><h1 class="page-title">Review general-member attendance</h1><p class="page-sub"><%= @meeting.title %> · <%= legion_datetime(@meeting.starts_at) %></p></div>
<section class="panel form-panel">
<%= render "shared/section_header", label: "Coverage and completeness" %>
<p>This register covers <strong><%= @entries.size %> named members</strong>. <%= @register ? "The original coverage list is preserved in later revisions." : "The initial list is the current directory-visible National roster. Confirm that it represents this meeting before marking it complete." %></p>
<p class="membership-secondary">A missing record is unknown. Officer roll call and speaking in a meeting do not prove general-member attendance. Each save preserves a new revision; minutes stay unchanged.</p>
<%= form_with url: membership_buddy_attendance_path(@meeting), method: :post, class: "stacked-form" do %>
  <%= hidden_field_tag :expected_revision, @register&.revision || 0 %>
  <div class="fl"><%= label_tag :coverage_note, "How was this general-member list checked?" %><%= text_area_tag :coverage_note, @coverage_note, class: "f", required: true, maxlength: 2000, rows: 3 %></div>
  <% @people.each do |person| %>
    <div class="fl"><%= label_tag "attendance_#{person.id}", person.full_name %><%= select_tag "entries[#{person.id}]", options_for_select(BuddyAttendanceRegister::STATUSES.map { |status| [status.humanize, status] }, @entries[person.id.to_s]), id: "attendance_#{person.id}", class: "f" %></div>
  <% end %>
  <label class="calendar-checkbox"><%= check_box_tag :complete, "1", @complete %> I reviewed attendance for every member listed for this general-member meeting. No entries remain “Not recorded.”</label>
  <div class="btnrow"><%= submit_tag "Save attendance revision", class: "btn-primary" %></div>
<% end %>
</section>
