<% if @show_passkey_invite %>
  <div class="pk-card" data-controller="passkey" data-passkey-redirect-value="/">
    <div class="pk-card-label">&#9670; Add a passkey</div>
    <h2 class="pk-card-title">A passkey is not a password</h2>
    <p class="pk-card-lead">
      It is a safe sign-in key stored by your phone, computer, browser, or password
      manager. You do not make up a word or memorize anything. Your device simply asks
      for the same fingerprint, face, or PIN you already use to unlock it.
    </p>
    <p class="pk-card-lead">
      This is optional. Most current phones and browsers support passkeys, and you can
      always keep signing in by email.
    </p>
    <div class="btnrow">
      <button type="button" class="btn-primary" data-action="passkey#register" data-passkey-target="submit">
        Set up a passkey
      </button>
      <%= button_to "Not now", passkey_invitation_path, method: :delete, class: "btn-secondary" %>
    </div>
    <p class="pk-card-status" data-passkey-target="status" role="status" aria-live="polite"></p>
  </div>
<% end %>

<% if @show_roster_email_review %>
  <%= render "roster_email_review" %>
<% end %>

<div class="page-lead">
  <h1 class="page-title"><%= @organization&.name || "LegionPostTools" %></h1>
  <p class="page-sub">Signed in as <%= current_user.person.full_name %>.</p>
</div>

<section class="hub-sec">
  <h2 class="hub-sec-h">Meetings</h2>
  <p class="hub-sec-n">See upcoming assemblies and browse the post's meeting record.</p>
  <div class="hub-tiles">
    <div class="tile">
      <div class="tile-ic" aria-hidden="true">📋</div>
      <p class="tile-t">Meetings</p>
      <p class="tile-d">See what is coming up, read published agendas, and return to past meetings.</p>
      <div class="tile-actions">
        <%= link_to "View meetings →", meetings_path, class: "tile-act" %>
      </div>
    </div>
  </div>
</section>
