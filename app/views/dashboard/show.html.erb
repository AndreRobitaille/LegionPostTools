<% if @show_roster_email_review %>
  <%= render "roster_email_review" %>
<% end %>

<div class="member-dashboard-grid">
  <main class="member-dashboard-main">
    <div class="page-lead member-dashboard-lead">
      <h1 class="page-title">Post meetings</h1>
      <p class="page-sub">What is coming up and the latest meeting record.</p>
    </div>

    <section class="member-dashboard-section">
      <%= render "shared/section_header", label: "Next meeting" %>
      <% if @next_meeting %>
        <%= render "meetings/member_meeting_card", meeting: @next_meeting, featured: true, show_schedule: true %>
      <% else %>
        <div class="member-meeting-empty">
          <h2>No meeting is scheduled</h2>
          <p>When an officer schedules the next meeting, it will appear here.</p>
        </div>
      <% end %>
    </section>

    <section class="member-dashboard-section">
      <%= render "shared/section_header", label: "Most recent meeting" %>
      <% if @recent_meeting %>
        <%= render "meetings/member_meeting_card", meeting: @recent_meeting %>
      <% else %>
        <div class="member-meeting-empty">
          <h2>No past meeting records yet</h2>
          <p>The latest completed meeting will appear here.</p>
        </div>
      <% end %>
    </section>

    <%= link_to "Browse all meetings", meetings_path, class: "member-dashboard-all-meetings" %>
  </main>

  <% if @show_passkey_invite %>
    <aside class="pk-card pk-card--sidebar" aria-labelledby="dashboard-passkey-heading" data-controller="passkey" data-passkey-redirect-value="/">
      <div class="pk-card-label">&#9670; Optional sign-in</div>
      <h2 class="pk-card-title" id="dashboard-passkey-heading">Sign in faster with a passkey</h2>
      <p class="pk-card-lead">Use the fingerprint, face, or PIN already on your device. Email sign-in will still work.</p>
      <div class="btnrow">
        <button type="button" class="btn-primary" data-action="passkey#register" data-passkey-target="submit">Set up a passkey</button>
        <%= button_to "Not now", passkey_invitation_path, method: :delete, class: "btn-secondary" %>
      </div>
      <p class="pk-card-status" data-passkey-target="status" role="status" aria-live="polite"></p>
    </aside>
  <% end %>
</div>
