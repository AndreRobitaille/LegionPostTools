<!DOCTYPE html>
<html>
  <head>
    <title><%= members_browser_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= render "shared/members_metadata" %>
    <%# Speculative form GETs can overwrite a newer confirmation's session cookie. %>
    <meta name="turbo-prefetch" content="false">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%# Lexxy (rich-text editor) first, then app styles so our theme overrides win %>
    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <% if authenticated? %>
      <%= render "shared/app_header" %>
      <%= render "shared/primary_nav" %>
    <% end %>
    <main class="app-main">
      <% if notice.present? %>
        <p class="app-flash app-flash-notice" role="status"><%= notice %></p>
      <% end %>
      <% if alert.present? %>
        <p class="app-flash app-flash-alert" role="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
