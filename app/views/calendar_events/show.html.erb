<% content_for :title, @event.title %>
<% category = CalendarCategories.for(@event) %>
<div class="calendar-event-page calendar-category--<%= category %>">
  <%= link_to "‹ Calendar", calendar_path(start_date: @event.starts_at.to_date, view: @public_preview ? "public" : nil), class: "calendar-event-back" %>
  <article class="calendar-event-card">
    <header class="calendar-event-heading">
      <div class="calendar-event-meta">
        <span class="calendar-event-type"><%= CalendarCategories::LABELS.fetch(category) %></span>
        <% unless category == "public_event" %><span class="calendar-event-visibility"><%= CalendarEvent::VISIBILITIES.fetch(@event.visibility) %></span><% end %>
      </div>
      <h1 class="page-title"><%= @event.title %></h1>
      <% if @event.cancelled? %><p class="calendar-cancelled" role="status">This event is cancelled.</p><% end %>
    </header>
    <section class="calendar-event-details" aria-label="Event details">
      <dl class="calendar-event-facts">
        <div>
          <dt>When</dt>
          <dd>
            <p class="calendar-event-date"><%= @event.starts_at.strftime("%A") %>, <%= legion_date(@event.starts_at) %><% if @event.ends_at && @event.ends_at.to_date != @event.starts_at.to_date %> – <%= @event.ends_at.strftime("%A") %>, <%= legion_date(@event.ends_at) %><% end %></p>
            <p class="calendar-event-time"><%= calendar_entry_time(@event) %></p>
            <% unless @event.all_day? %><p class="calendar-event-timezone">Times in <%= Time.zone.name %></p><% end %>
          </dd>
        </div>
        <% if @event.location.present? %><div><dt>Where</dt><dd><%= @event.location %></dd></div><% end %>
      </dl>
      <% if @event.description.present? %><div class="calendar-event-description"><%= simple_format(@event.description) %></div><% end %>
      <% if !@public_preview && @event.endeavor %>
        <dl class="calendar-event-related"><div><dt>Related Endeavor</dt><dd><%= link_to @event.endeavor.title, endeavor_path(@event.endeavor) %></dd></div></dl>
      <% end %>
      <% if !@public_preview && current_user.can_manage_calendar? %>
        <footer class="calendar-event-actions"><%= link_to "Edit event", edit_calendar_event_path(@event), class: "calendar-create" %></footer>
      <% end %>
    </section>
  </article>
</div>
