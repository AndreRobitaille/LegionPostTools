<% publication = @event.website_publication %>
<section class="panel publishing-panel">
  <h2 class="section-title">Public website</h2>
  <% if publication&.published? %>
    <p>Saving calendar changes leaves the approved public schedule and wording in place. Cancellation takes effect immediately. Making this event private or internal withdraws it.</p>
    <%= render "admin/website_publications/snapshot", publication: publication %>
    <% if publication.pending_source_changes? %><p class="flash flash--alert">Calendar changes are waiting for a publisher to review.</p><% end %>
  <% else %><p>This event is not published on the public website. Calendar visibility alone does not publish it.</p><% end %>
  <% if current_user.can?("publish_public_content") %>
    <% if publication %><%= link_to "Review public version", edit_admin_website_publication_path(publication), class: "btn-secondary" %><% else %><%= button_to "Review for public website", admin_website_publications_path, params: { calendar_event_id: @event.id }, class: "btn-secondary" %><% end %>
  <% else %><p class="form-help">A person with Publish public website content permission can review and publish changes.</p><% end %>
</section>
