<% content_for :title, @endeavor.title %>
<div data-controller="source-reader" data-action="turbo:before-cache@document->source-reader#beforeCache">
<%= link_to "← Endeavors", endeavors_path, class: "back" %>

<div class="endeavor-lead">
  <h1 class="page-title"><%= @endeavor.title %></h1>
  <div class="idmeta">
    <%= endeavor_status_tag(@endeavor) %>
    <% if @endeavor.active? && current_user.can?("manage_agendas") %><span class="office"><%= Endeavor::PRIORITY_BUCKETS.fetch(@endeavor.priority_bucket) %></span><% end %>
  </div>
  <% if @endeavor.summary.present? && @history.overview.empty? %>
    <p class="endeavor-summary"><%= @endeavor.summary %></p>
  <% end %>
</div>

<div class="endeavor-mobile-nav"><%= render "page_navigation" %></div>
<div class="endeavor-grid">
  <div class="endeavor-record">
    <%= render "history", history: @history %>

    <section class="endeavor-secondary" aria-label="Calendar events">
      <h2>Calendar events</h2>
      <% if @calendar_events.empty? %><p>No upcoming events are scheduled for this Endeavor.</p><% end %>
      <% @calendar_events.each do |event| %>
        <p><%= link_to event.title, calendar_event_path(event) %> · <%= legion_date(event.starts_at) %> · <%= calendar_entry_label(event) %></p>
      <% end %>
      <% if current_user.can_manage_calendar? %><%= link_to "Add calendar event", new_calendar_event_path(endeavor_id: @endeavor.id), class: "btn-secondary" %><% end %>
    </section>

    <details id="endeavor-background" class="endeavor-secondary">
      <summary>Background and details</summary>
      <div class="prose">
        <% if @endeavor.summary.present? && @history.overview.any? %><p><%= @endeavor.summary %></p><% end %>
        <%= @endeavor.details %>
      </div>
      <dl class="endeavor-background-facts">
        <% if @endeavor.meeting_body %><div><dt>Usually discussed by</dt><dd><%= @endeavor.meeting_body.name %></dd></div><% end %>
        <div><dt>Started by</dt><dd><%= @endeavor.created_by.person.full_name %> · <%= legion_date(@endeavor.created_at) %></dd></div>
        <% if @endeavor.completed? %><div><dt>Completed</dt><dd><%= @endeavor.completed_by.person.full_name %> · <%= legion_date(@endeavor.completed_at) %></dd></div><% end %>
      </dl>
    </details>

    <% if current_user.can?("manage_agendas") %>
      <details class="endeavor-secondary endeavor-update">
        <summary>Add an update</summary>
        <div class="panel">
          <p class="panel-lead">Record what changed, or what the next officer needs to know. Updates become part of the trail and cannot be rewritten later.</p>
          <%= form_with model: EndeavorUpdate.new, url: endeavor_updates_path(@endeavor), class: "stacked-form" do |form| %>
            <div class="fl">
              <%= form.label :body, "Update" %>
              <%= form.rich_text_area :body, attachments: "false" %>
            </div>
            <div class="btnrow"><%= form.submit "Add update", class: "btn-primary" %></div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <aside class="endeavor-rail">
    <%= render "page_navigation" %>
    <% if current_user.can?("manage_agendas") %>
      <section class="card endeavor-officer-tools" aria-label="Officer tools">
        <div class="card-head"><span class="card-head-label">Officer tools</span></div>
        <div class="card-body">
          <% if @endeavor.active? %><p class="history-note"><%= endeavor_reason(@endeavor, with_date: true) %></p><% end %>
          <div class="endeavor-fact-actions">
            <%= link_to "AI history", admin_endeavor_history_path(@endeavor), class: "btn-secondary" %>
            <%= link_to "Edit details", edit_endeavor_path(@endeavor), class: "btn-secondary" %>
            <% if @endeavor.active? %>
              <%= button_to "Mark complete", complete_endeavor_path(@endeavor), method: :patch, class: "btn-primary", data: { turbo_confirm: "Mark “#{@endeavor.title}” complete? Its history stays available." } %>
            <% else %>
              <%= button_to "Reopen", reopen_endeavor_path(@endeavor), method: :patch, class: "btn-secondary" %>
            <% end %>
          </div>
        </div>
      </section>
    <% end %>
  </aside>
</div>
<%= render "source_reader" %>
</div>
