<dialog class="source-reader" aria-labelledby="source-reader-title" data-source-reader-target="dialog" data-action="close->source-reader#closed click->source-reader#backdrop">
  <div class="source-reader-shell">
    <header class="source-reader-header">
      <h2 id="source-reader-title">Source minutes</h2>
      <button type="button" class="btn-secondary" data-source-reader-target="close" data-action="source-reader#close">Close <span aria-hidden="true">×</span></button>
    </header>
    <div class="source-reader-content" data-source-reader-target="content" aria-live="polite"></div>
  </div>
</dialog>
