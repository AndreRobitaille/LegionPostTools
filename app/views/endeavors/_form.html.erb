<div class="panel form-panel">
  <%= form_with model: endeavor, class: "stacked-form" do |form| %>
    <% if endeavor.errors.any? %>
      <div class="error-summary">
        <h2><%= pluralize(endeavor.errors.count, "error") %> prevented this Endeavor from being saved:</h2>
        <ul><% endeavor.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>

    <%= form.hidden_field :lock_version if endeavor.persisted? %>
    <div class="fl">
      <%= form.label :title, "Endeavor name" %>
      <%= form.text_field :title, class: "f", autofocus: true %>
      <span class="form-help">Use the wording officers will recognize at a meeting.</span>
    </div>
    <div class="fl">
      <%= form.label :summary, "Summary" %>
      <%= form.text_area :summary, class: "f", rows: 3 %>
      <span class="form-help">Briefly describe the work. Add individual next steps on the Endeavor page.</span>
    </div>
    <div class="endeavor-form-grid">
      <div class="fl">
        <%= form.label :meeting_body_id, "Usually discussed by" %>
        <%= form.collection_select :meeting_body_id, @meeting_bodies, :id, :name, { include_blank: "Any post meeting" }, class: "f" %>
      </div>
      <div class="fl">
        <%= form.label :importance %>
        <%= form.select :importance, Endeavor::IMPORTANCE_LEVELS.map { |value, label| [ label, value ] }, {}, class: "f" %>
      </div>
    </div>
    <div class="fl">
      <%= form.label :due_on, "Overall due date (optional)" %>
      <%= render "shared/editable_date_field", name: "endeavor[due_on]", id: "endeavor_due_on", value: params.dig(:endeavor, :due_on) || endeavor.due_on %>
      <span class="form-help">When should this project be finished? Leave blank for continuing work. Add event dates separately.</span>
    </div>
    <div class="fl">
      <%= form.label :details, "Background and context" %>
      <%= form.rich_text_area :details, attachments: "false" %>
    </div>
    <div class="btnrow">
      <%= form.submit(endeavor.persisted? ? "Save changes" : "Create Endeavor", class: "btn-primary") %>
      <%= link_to "Cancel", endeavor.persisted? ? endeavor_path(endeavor) : endeavors_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
