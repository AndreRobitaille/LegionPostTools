<% content_for :title, "Tracked Items" %>

<div class="page-lead-row">
  <div class="page-lead">
    <h1 class="page-title">Tracked Items</h1>
    <p class="page-sub">Unfinished post business, kept visible across meetings and officer transitions.</p>
  </div>
  <% if current_user.can?("manage_agendas") %>
    <%= link_to "Track new business", new_tracked_item_path, class: "btn-primary" %>
  <% end %>
</div>

<div class="tracked-docket">
  <% if @priority_groups.values.any?(&:any?) %>
    <% @priority_groups.each do |bucket, items| %>
      <% next if items.empty? %>
      <section class="tracked-bucket tracked-bucket--<%= bucket %>">
        <%= render "shared/section_header", label: TrackedItem::PRIORITY_BUCKETS.fetch(bucket), meta: pluralize(items.size, "item") %>
        <div class="mrow-list">
          <% items.each do |tracked_item| %>
            <%= render "tracked_item", tracked_item: tracked_item %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="empty">
      <span class="empty-mark" aria-hidden="true">&#9670;</span>
      <div>
        <h2>Nothing is being tracked yet</h2>
        <p>Start with one piece of business that has to come back at a future meeting — a repair, a licence renewal, a decision the post deferred.</p>
        <% if current_user.can?("manage_agendas") %>
          <div class="btnrow"><%= link_to "Track new business", new_tracked_item_path, class: "btn-primary" %></div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @completed_items.any? %>
    <section class="tracked-bucket">
      <%= render "shared/section_header", label: "Recently completed", meta: pluralize(@completed_items.size, "item") %>
      <div class="mrow-list">
        <% @completed_items.each do |tracked_item| %>
          <%= render "tracked_item", tracked_item: tracked_item %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
