<%# Uses the shared row grammar: identity on the left, the one fact that matters
    in a quiet column at a divider, action on the same row. %>
<% row_classes = [ "mrow", "catrow" ]
   row_classes << "mrow--important" if tracked_item.important? && tracked_item.active?
   row_classes << "mrow--done" if tracked_item.completed?
   due_label = tracked_item_due_label(tracked_item) %>
<%= link_to tracked_item_path(tracked_item), class: row_classes.join(" ") do %>
  <span class="mrow-id">
    <span class="mrow-l1"><span class="mrow-name"><%= tracked_item.title %></span></span>
    <% if tracked_item.summary.present? %>
      <span class="mrow-sub"><%= tracked_item.summary %></span>
    <% end %>
    <span class="tracked-why"><%= tracked_item_reason(tracked_item) %></span>
  </span>
  <span class="mrow-status">
    <% if due_label %>
      <span class="mrow-kv"><span class="k"><%= due_label %></span> <%= legion_date(tracked_item.raise_by_on) %></span>
    <% elsif tracked_item.completed? %>
      <span class="mrow-kv"><span class="k">Completed</span> <%= legion_date(tracked_item.completed_at) %></span>
    <% end %>
    <% if tracked_item.meeting_body %>
      <span class="mrow-kv"><span class="k">For</span> <%= tracked_item.meeting_body.name %></span>
    <% end %>
  </span>
  <span class="catrow-meta">
    <span class="catrow-edit">Open <span class="catrow-caret" aria-hidden="true">›</span></span>
  </span>
<% end %>
