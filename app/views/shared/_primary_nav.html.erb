<%# app/views/shared/_primary_nav.html.erb
    The tab strip. Hidden at phone widths, where the same destinations are
    carried by the header's Menu instead (see _app_header). %>
<nav class="nav-bar">
  <div class="nav-inner">
    <% primary_destinations.each do |destination| %>
      <%= link_to destination[:label], destination[:path], nav_tab_attributes(destination[:section]) %>
    <% end %>
  </div>
</nav>
