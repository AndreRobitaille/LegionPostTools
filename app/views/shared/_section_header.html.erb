<%# app/views/shared/_section_header.html.erb
    The one section header in the working UI: diamond + tracked label + gold rule.
    Locals: label: (String), meta: (String, optional), action: (html, optional),
    heading_tag: (optional, defaults to span), heading_id: (String, optional).
    The rule sits between the label and any trailing slot, so a count or an
    action is never stranded at the far edge of the page. %>
<% meta = local_assigns[:meta] %>
<% action = local_assigns[:action] %>
<div class="sec-head">
  <span class="sec-head-dia" aria-hidden="true">&#9670;</span>
  <%= content_tag local_assigns.fetch(:heading_tag, :span), label, class: "sec-head-label", id: local_assigns[:heading_id] %>
  <span class="sec-head-rule"></span>
  <% if meta.present? %><span class="sec-head-meta"><%= meta %></span><% end %>
  <%= action %>
</div>
