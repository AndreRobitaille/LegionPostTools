<meta name="application-name" content="<%= members_site.name %>">
<meta name="apple-mobile-web-app-title" content="<%= members_site.name %>">
<meta name="description" content="<%= members_site.description %>">
<meta property="og:title" content="<%= members_site.name %>">
<meta property="og:site_name" content="<%= members_site.name %>">
<meta property="og:description" content="<%= members_site.description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= members_site.entry_url %>">
<meta property="og:image" content="<%= members_site.image_url %>">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= members_site.image_alt %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= members_site.name %>">
<meta name="twitter:description" content="<%= members_site.description %>">
<meta name="twitter:image" content="<%= members_site.image_url %>">
<meta name="twitter:image:alt" content="<%= members_site.image_alt %>">
<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48">
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
<link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">
