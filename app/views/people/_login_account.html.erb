<%# Locals: @person, @user, @can_manage. %>

<% if @user %>
  <div class="acct-line">
    <span>Signs in as <span class="em"><%= @user.email_address %></span></span>
    <% if @user.disabled_at.blank? %>
      <span class="badge-on">Can sign in</span>
    <% else %>
      <span class="badge-off">Cannot sign in</span>
    <% end %>
  </div>

  <% if @user.disabled_at.present? %>
    <div class="acct-mode acct-mode--off">
      <span class="acct-mode-dot" aria-hidden="true">&#9679;</span>
      <span>
        <b><%= disabled_signin_reason_sentence(@user) %>.</b>
        <% if @user.manually_disabled? %>
          Roster imports will leave sign-in off until an administrator enables it again.
        <% elsif @user.roster_managed? %>
          Sign-in will return automatically if a later roster shows an Active or Grace status.
        <% end %>
      </span>
    </div>
  <% elsif @user.login_access_override? %>
    <div class="acct-mode acct-mode--manual">
      <span class="acct-mode-dot" aria-hidden="true">&#9679;</span>
      <span>
        <b>Sign-in is managed locally.</b>
        <% if @user.roster_managed? %>
          Return this account to automatic roster access.
        <% else %>
          This person has no National roster record.
        <% end %>
      </span>
    </div>
  <% else %>
    <div class="acct-mode acct-mode--on">
      <span class="acct-mode-dot" aria-hidden="true">&#9679;</span>
      <span><b>Sign-in follows the National roster.</b> Active and Grace members stay on automatically.</span>
    </div>
  <% end %>

  <% if @user.roster_email_mismatch? && @user == current_user %>
    <div class="pk-card">
      <div class="pk-card-label">&#9888; Roster email doesn't match login email</div>
      <p class="pk-card-lead">
        The roster email (<%= @person.roster_email_address %>) doesn't match this login email (<%= @user.email_address %>).
        The roster import never changes how someone signs in — this can be updated here if it should match.
      </p>
      <%= button_to "Use roster email for login", roster_email_review_path(decision: "update_login"), method: :patch, class: "btn-primary btn-sm", form: { class: "inline" } %>
      <%= button_to "Keep current login email", roster_email_review_path(decision: "keep_current"), method: :patch, class: "btn-secondary btn-sm", form: { class: "inline" } %>
    </div>
  <% end %>

  <% if @can_manage %>
    <% if @user.disabled_at.present? %>
      <div class="btnrow">
        <%= form_with url: admin_person_user_account_path(@person), scope: :user, class: "account-email-form" do |form| %>
          <div class="fl">
            <%= form.label :email_address, "Login email" %>
            <%= form.email_field :email_address, value: @user.email_address, class: "f" %>
          </div>
          <%= form.submit login_email_submit_label(@user), class: "btn-primary" %>
        <% end %>
      </div>
      <% if @user.roster_managed? && !@user.roster_access_should_enable? %>
        <p class="helper">The email can be corrected now, but roster-managed sign-in stays off until National shows an Active or Grace status.</p>
      <% end %>
    <% else %>
      <div class="btnrow">
        <%= button_to "Disable sign-in", admin_person_user_account_path(@person), method: :delete, class: "btn-return" %>
        <span class="helper">Keeps their record, roles, and permissions. Roster imports will leave sign-in off until an administrator enables it again.</span>
      </div>
    <% end %>

    <% if @user.login_access_override? && @user.disabled_at.blank? && @user.roster_managed? %>
      <div class="btnrow">
        <%= button_to "Use automatic roster access", roster_control_admin_person_user_account_path(@person), method: :patch, class: "btn-secondary" %>
        <span class="helper">Sign-in will immediately match this member's current roster status.</span>
      </div>
    <% end %>

    <%= render "permission_groups" %>
  <% end %>
<% elsif @can_manage && (User::ROSTER_LOGIN_ENABLED_STATUSES.include?(@person.normalized_roster_status) || !@person.roster_backed?) %>
  <div class="acct-mode acct-mode--off">
    <span class="acct-mode-dot" aria-hidden="true">&#9679;</span>
    <span>
      <b>No login account was created.</b>
      <% if @person.roster_backed? %>
        Check for a missing, invalid, shared, or already-used roster email.
      <% else %>
        This person is not controlled by a National roster record.
      <% end %>
    </span>
  </div>
  <%= form_with url: admin_person_user_account_path(@person), scope: :user, class: "account-email-form" do |form| %>
    <div class="fl">
      <%= form.label :email_address, "Login email" %>
      <%= form.email_field :email_address, value: @person.roster_email_address, class: "f" %>
    </div>
    <%= form.submit "Create login account", class: "btn-primary" %>
  <% end %>
  <p class="helper">Use an address that belongs to this person and is not used by another account.</p>
<% elsif @can_manage %>
  <div class="acct-mode acct-mode--off">
    <span class="acct-mode-dot" aria-hidden="true">&#9679;</span>
    <span><b>No login account.</b> National roster status is <%= @person.roster_member_status.presence || "not recognized" %>, so sign-in is not enabled.</span>
  </div>
<% else %>
  <p class="page-sub">This member does not have a login account.</p>
<% end %>
