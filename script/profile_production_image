#!/usr/bin/env bash
# Run only on an isolated Docker host, never on the shared production VPS.
set -Eeuo pipefail

revision="${1:?usage: script/profile_production_image REVISION LABEL OUTPUT_DIR}"
label="${2:?missing label}"
output="${3:?missing output directory}"
[[ "$label" =~ ^[a-z0-9-]+$ ]] || exit 64
mkdir -p "$output"
output="$(cd "$output" && pwd)"
context="$(mktemp -d)"
builder="legion-profile-$label"
image="legion-profile:$label"
monitor_pid=""
cleanup() {
  [[ -z "$monitor_pid" ]] || { kill "$monitor_pid" 2>/dev/null || true; wait "$monitor_pid" 2>/dev/null || true; }
  docker buildx rm "$builder" >/dev/null
  rm -rf "$context"
}
trap cleanup EXIT

git archive "$revision" | tar -x -C "$context"
git rev-parse "$revision" > "$output/revision.txt"
docker version > "$output/docker-version.txt"
docker buildx create --name "$builder" --driver docker-container \
  --driver-opt image=moby/buildkit:v0.32.2,memory=1536m,memory-swap=1536m
docker buildx inspect "$builder" --bootstrap
container="buildx_buildkit_${builder}0"
docker inspect --format '{{json .HostConfig}}' "$container" > "$output/builder-config.json"
builder_pid="$(docker inspect --format '{{.State.Pid}}' "$container")"
cgroup="/sys/fs/cgroup$(awk -F: '$1 == "0" {print $3}' "/proc/$builder_pid/cgroup")"
test -r "$cgroup/memory.peak"

(
  echo 'time,current,anon,file,peak'
  while true; do
    awk -v time="$(date +%s)" -v current="$(cat "$cgroup/memory.current")" \
      -v peak="$(cat "$cgroup/memory.peak")" '
        $1 == "anon" { anon = $2 }
        $1 == "file" { file = $2 }
        END { print time "," current "," anon "," file "," peak }
      ' "$cgroup/memory.stat"
    sleep 1
  done
) > "$output/memory.csv" &
monitor_pid="$!"

build_status=0
docker buildx build --builder "$builder" --platform linux/amd64 --progress plain \
  --label service=legion_post_165_wi_tools \
  --label "org.opencontainers.image.revision=$(git rev-parse "$revision")" \
  --label org.opencontainers.image.source=https://github.com/AndreRobitaille/LegionPostTools \
  --provenance=false --load --tag "$image" "$context" 2>&1 | tee "$output/build.log" || build_status="$?"
cat "$cgroup/memory.peak" > "$output/memory.peak"
cat "$cgroup/memory.events" > "$output/memory.events"
cat "$cgroup/memory.stat" > "$output/memory.stat"
echo "$build_status" > "$output/build-status.txt"
[[ "$build_status" == 0 ]] || exit "$build_status"

docker image inspect "$image" --format '{{.Size}}' > "$output/image-size.txt"
docker run --rm --entrypoint ruby "$image" -e \
  'require "json"; puts JSON.pretty_generate(Gem::Specification.map { |s| [s.name, s.version.to_s] }.sort)' \
  > "$output/gems.json"
docker run --rm --entrypoint pg_dump "$image" --version | tee "$output/postgres-client.txt"
if [[ "$label" != baseline ]]; then
  docker run --rm --network none --memory 512m --memory-swap 512m \
    --env SECRET_KEY_BASE_DUMMY=1 --env WEBAUTHN_ORIGIN=https://example.invalid \
    --env WEBAUTHN_RP_ID=example.invalid --env WEBAUTHN_RP_NAME=BuildVerification \
    --entrypoint ruby "$image" script/production_image_smoke.rb | tee "$output/smoke.txt"
fi
awk '{printf "Build peak: %.1f MiB\n", $1 / 1048576}' "$output/memory.peak"
awk '{printf "Image size: %.1f MiB\n", $1 / 1048576}' "$output/image-size.txt"
